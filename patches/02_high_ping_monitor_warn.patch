From: Code Review Fix <review@fix>
Subject: [PATCH 02] High: ping-monitor.sh warn 함수 정의 및 remote_args 인용 수정

set -euo pipefail 환경에서 warn 호출 시 스크립트가 즉시 종료되는 버그 수정.
또한 ${remote_args[*]} → "${remote_args[@]}" 수정으로 공백 포함 인자 안전 전달.

---
 dist/wlan/usr/local/tools/ping-monitor/ping-monitor.sh | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/dist/wlan/usr/local/tools/ping-monitor/ping-monitor.sh b/dist/wlan/usr/local/tools/ping-monitor/ping-monitor.sh
index 0000001..0000002 100755
--- a/dist/wlan/usr/local/tools/ping-monitor/ping-monitor.sh
+++ b/dist/wlan/usr/local/tools/ping-monitor/ping-monitor.sh
@@ -18,6 +18,7 @@ PCAP_WLAN=""
 # --- 유틸리티 ---
 die()  { echo "ERROR: $*" >&2; exit 1; }
 info() { echo "INFO: $*"; }
+warn() { echo "WARN: $*" >&2; }

 usage() {
     cat <<'EOF'
@@ -322,7 +323,7 @@ exec_remote() {
         remote_args+=("$arg")
     done

-    ssh -t "root@${host}" "bash /tmp/ping-monitor.sh ${remote_args[*]}"
+    ssh -t "root@${host}" bash /tmp/ping-monitor.sh "${remote_args[@]}"
     local exit_code=$?

     # pcap 복사
