From: Code Review Fix <review@fix>
Subject: [PATCH 05] Medium: wifi.sh show_iface_config jq 호출 최적화

인터페이스당 11회 반복 jq 서브프로세스 → 1회 읽기 + 쉘 변수로 처리.
동일 JSON 파일을 반복 파싱하는 오버헤드 제거.

---
 dist/wlan/usr/local/scripts/wifi.sh | 26 +++++++++++++-------------
 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/dist/wlan/usr/local/scripts/wifi.sh b/dist/wlan/usr/local/scripts/wifi.sh
index 0000001..0000002 100755
--- a/dist/wlan/usr/local/scripts/wifi.sh
+++ b/dist/wlan/usr/local/scripts/wifi.sh
@@ -200,22 +200,22 @@ show_info() {
         show_iface_config() {
             local iface="$1"
             if [ -f "$WIFI_INIT_CONF_JSON" ] && command -v jq >/dev/null 2>&1; then
-                local enabled freq net_rx bgscan_interval
-                local roam_th_2g roam_th_5g roam_diff roam_check
-                local pred_en load_en pingpong_en adaptive_en
-
-                enabled=$(jq -r ".${iface}.enabled // true" "$WIFI_INIT_CONF_JSON")
-                freq=$(jq -r ".${iface}.Frequency // \"auto\"" "$WIFI_INIT_CONF_JSON")
-                net_rx=$(jq -r ".${iface}.net_rx // 0" "$WIFI_INIT_CONF_JSON")
-                bgscan_interval=$(jq -r ".${iface}.bgscan.interval // 60" "$WIFI_INIT_CONF_JSON")
-                roam_th_2g=$(jq -r ".${iface}.roaming.DEFAULT_TH_2G // -75" "$WIFI_INIT_CONF_JSON")
-                roam_th_5g=$(jq -r ".${iface}.roaming.DEFAULT_TH_5G // -75" "$WIFI_INIT_CONF_JSON")
-                roam_diff=$(jq -r ".${iface}.roaming.DIFF_TH // 10" "$WIFI_INIT_CONF_JSON")
-                roam_check=$(jq -r ".${iface}.roaming.CHECK_INTERVAL // 5" "$WIFI_INIT_CONF_JSON")
-                pred_en=$(jq -r ".${iface}.roaming.PREDICTIVE_ROAM.enable // true" "$WIFI_INIT_CONF_JSON")
-                load_en=$(jq -r ".${iface}.roaming.LOAD_BASED_ROAM.enable // false" "$WIFI_INIT_CONF_JSON")
-                pingpong_en=$(jq -r ".${iface}.roaming.PING_PONG_PREVENTION.enable // true" "$WIFI_INIT_CONF_JSON")
-                adaptive_en=$(jq -r ".${iface}.roaming.ADAPTIVE_INTERVAL.enable // true" "$WIFI_INIT_CONF_JSON")
+                local enabled freq net_rx bgscan_interval \
+                      roam_th_2g roam_th_5g roam_diff roam_check \
+                      pred_en load_en pingpong_en adaptive_en
+
+                read -r enabled freq net_rx bgscan_interval \
+                         roam_th_2g roam_th_5g roam_diff roam_check \
+                         pred_en load_en pingpong_en adaptive_en \
+                    < <(jq -r --arg iface "$iface" '
+                        [ (.[$iface].enabled // true),
+                          (.[$iface].Frequency // "auto"),
+                          (.[$iface].net_rx // 0),
+                          (.[$iface].bgscan.interval // 60),
+                          (.[$iface].roaming.DEFAULT_TH_2G // -75),
+                          (.[$iface].roaming.DEFAULT_TH_5G // -75),
+                          (.[$iface].roaming.DIFF_TH // 10),
+                          (.[$iface].roaming.CHECK_INTERVAL // 5),
+                          (.[$iface].roaming.PREDICTIVE_ROAM.enable // true),
+                          (.[$iface].roaming.LOAD_BASED_ROAM.enable // false),
+                          (.[$iface].roaming.PING_PONG_PREVENTION.enable // true),
+                          (.[$iface].roaming.ADAPTIVE_INTERVAL.enable // true) ]
+                        | @tsv' "$WIFI_INIT_CONF_JSON")

                 echo "  [${iface}]"
                 echo "    enabled=$enabled  Frequency=$freq  net_rx=$net_rx"
