From: Code Review Fix <review@fix>
Subject: [PATCH 01] Critical: rsync_wlan.sh 하드코딩 비밀번호 제거

하드코딩된 평문 비밀번호(sshpass -p 'jhw'), 고정 IP(192.168.0.2),
StrictHostKeyChecking=no 를 제거하고 SSH 키 기반 인증 + 환경변수 방식으로 교체.

---
 dist/wlan/opt/wlan/test/rsync_wlan.sh | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/dist/wlan/opt/wlan/test/rsync_wlan.sh b/dist/wlan/opt/wlan/test/rsync_wlan.sh
index 0000001..0000002 100755
--- a/dist/wlan/opt/wlan/test/rsync_wlan.sh
+++ b/dist/wlan/opt/wlan/test/rsync_wlan.sh
@@ -1,5 +1,13 @@
 #!/bin/bash
-FILE_NAME='wlan.deb'
-sshpass -p 'jhw' rsync -av --progress \
-    -e 'ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null' \
-    jhw@192.168.0.2:/home/jhw/ai/opencode/projects/wlan-package/release/$FILE_NAME .
+# rsync_wlan.sh — 빌드 서버에서 wlan.deb 가져오기
+# 사용법: RSYNC_HOST=user@host RSYNC_PATH=/path/to/release ./rsync_wlan.sh
+# SSH 키 기반 인증 필요: ssh-copy-id user@host
+
+FILE_NAME='wlan.deb'
+RSYNC_HOST="${RSYNC_HOST:-}"
+RSYNC_PATH="${RSYNC_PATH:-}"
+
+if [ -z "$RSYNC_HOST" ] || [ -z "$RSYNC_PATH" ]; then
+    echo "Usage: RSYNC_HOST=user@host RSYNC_PATH=/path/to/release $0" >&2
+    exit 1
+fi
+
+rsync -av --progress -e 'ssh -o BatchMode=yes' \
+    "${RSYNC_HOST}:${RSYNC_PATH}/${FILE_NAME}" .
