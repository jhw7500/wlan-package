[Unit]
Description=WiFi ARP Service
#Conflicts=wifi_ping@mlan0.service wifi_ping@mlan1.service
After=network.target
#Requires=wpa_supplicant@%i.service

[Service]
Type=simple
ExecStart=/usr/sbin/wpa_cli -i %i -a /usr/local/scripts/wifi_arp.sh
Restart=always
RestartSec=2
User=root
#RemainAfterExit=true

[Install]
WantedBy=multi-user.target

