[Unit]
Description=WBRIDGE thermal state updater
After=local-fs.target wifi_init.service
Wants=local-fs.target
PartOf=wifi_init.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/wbridge
ExecStart=/usr/local/scripts/wifi_thermal_state_update.sh
User=root
StandardOutput=null
StandardError=journal
LogLevelMax=notice

[Install]
WantedBy=multi-user.target
