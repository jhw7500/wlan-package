[Unit]
Description=WiFi Logging for Service %i
#After=network.target
#PartOf=wifi_logger.service
BindsTo=sys-subsystem-net-devices-%i.device
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wifi_init.service
PartOf=wifi_init.service
# link/scan/stat/snapshot 로거는 systemd 가 직접 감독(Restart=always)하는 별도 유닛으로
# 분리. 이 유닛이 뜰 때 함께 pull-in 되고, PartOf(각 유닛 쪽)로 stop/restart 가 전파된다.
# (scan/stat/snapshot 은 유닛 쪽 Condition 으로 무선 iface 전용 — eth0 인스턴스는 스킵)
Wants=wifi_logger_link@%i.service wifi_logger_scan@%i.service wifi_logger_stat@%i.service wifi_link_snapshot@%i.service

[Service]
ExecStart=/usr/local/scripts/wifi_logger_start.sh %i
ExecStop=/usr/local/scripts/wifi_logger_stop.sh %i
RemainAfterExit=true
#Restart=always
User=root
# 자식 Python/shell의 비구조화 stdout·stderr가 logger.log에 섞이지 않게 한다.
# local0 logger/Python SysLogHandler와 stat/scan 등 개별 로그 파일은 영향 없음.
StandardOutput=null
StandardError=null

[Install]
WantedBy=wifi-stack.target
