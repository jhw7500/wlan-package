[Unit]
Description=WiFi Logging for Service %i
#After=network.target
#PartOf=wifi_logger.service
BindsTo=sys-subsystem-net-devices-%i.device
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wifi_init.service
PartOf=wifi_init.service
# link 로거는 systemd 가 직접 감독(Restart=always)하는 별도 유닛으로 분리. 이 유닛이
# 뜰 때 함께 pull-in 되고, PartOf(link 유닛 쪽)로 stop/restart 가 전파된다.
Wants=wifi_logger_link@%i.service

[Service]
ExecStart=/usr/local/scripts/wifi_logger_start.sh %i
ExecStop=/usr/local/scripts/wifi_logger_stop.sh %i
RemainAfterExit=true
#Restart=always
User=root

[Install]
WantedBy=wifi-stack.target

