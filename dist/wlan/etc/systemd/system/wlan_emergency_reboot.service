[Unit]
Description=Emergency reboot when wifi_init permanently fails
# wifi_init.service 의 OnFailure= 에서 트리거됨. StartLimitBurst 소진 후
# 호출되므로 cooldown/uptime 정책만 준수하여 자동 리부트를 요청한다.
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
# wlan_reboot_policy.sh 가 uptime/cooldown 기반 loop 방지를 처리한다.
# reason은 journal 에 기록되어 사후 분석 가능.
Environment=MAX_REBOOT_COUNT=3
Environment=REBOOT_COOLDOWN_SEC=300
Environment=MIN_UPTIME_SEC=60
ExecStart=/usr/local/scripts/wlan_reboot_policy.sh --source wifi_init --reason "wifi_init StartLimit exhausted (module load hang or permanent failure)"
