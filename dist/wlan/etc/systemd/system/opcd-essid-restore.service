[Unit]
Description=Restore the ESSID that OPC ChangeIpAddress replaced, before the Wi-Fi stack reads wpa_supplicant-mlan0.conf (wlan-opc#161)
Documentation=https://github.com/jhw7500/wlan-package/issues/362
# wifi_init.service 와 같은 층위(DefaultDependencies=no, local-fs 뒤)에서, wifi_init.sh 의 conf 재생성과
# wpa_supplicant@mlan0 의 conf 읽기보다 먼저 한 번 돈다. opcd -R 은 conf writer lock 을 잡지 않으므로
# 이 순서가 배타성을 보장한다. 표식이 없으면(ChangeIp 를 쓴 적이 없거나 이미 복원됨) 실행하지 않는다.
DefaultDependencies=no
After=local-fs.target sysinit.target
Before=wifi_init.service wpa_supplicant@mlan0.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/usr/local/opc/etc/changeip_essid.restore

[Service]
Type=oneshot
# exit 0: 복원했거나(rc=1 "original ESSID restored"), 되돌릴 것이 없거나, 다른 작성자가 바꾼 값이라
# 표식만 지움. exit 1: 표식·conf 를 읽을 수 없음(둘 다 그대로 둠). 어느 쪽도 wifi_init 을 막지
# 않는다 — wifi_init.service 는 이 유닛을 Requires 하지 않고 순서만 따른다.
ExecStart=/usr/local/opc/bin/opcd -R

[Install]
# wifi_init.service 와 같은 target 에 걸어 부팅 경로에서만 돈다. 런타임의 wifi_init 재시작은 이
# 유닛을 끌어오지 않는다 — ChangeIp 의 ESSID 는 재부팅 때 되돌아가는 것이 사양이다.
# postinst 가 항상 enable 한다(.opc.enabled 게이트와 무관): OPC 를 끈 뒤 재부팅해도 남은 ChangeIp
# ESSID 는 되돌아가야 하고, 표식이 없으면 위 ConditionPathExists 가 실행 자체를 거른다.
WantedBy=wifi-stack.target
