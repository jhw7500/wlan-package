[Unit]
Description=WiFi Link Snapshot for %i (supervised — produces snap.log)
# snap.log(주기 링크 스냅샷)를 남기는 wifi_link_snapshot.sh 가 기존엔 wifi_logger_start.sh
# 의 & 백그라운드 자식으로 떠 systemd 감독 밖에 있었고, 런타임에 죽으면 재시작되지 않아
# 스냅샷이 조용히 멈췄다. Type=simple + Restart=always 로 systemd 가 직접 감독·재시작해
# 단일 실패에도 자동 복구한다.
BindsTo=sys-subsystem-net-devices-%i.device
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wifi_init.service
# wifi_logger@%i / wifi_init 재시작·정지에 생명주기 연동(stop/restart 전파).
# wifi_logger@%i 의 Wants= 로 pull-in 되므로 [Install] 은 두지 않는다(엄격한 자식 유닛,
# 별도 systemctl enable 불필요 — 이중 활성화/순서 모호성 제거).
PartOf=wifi_init.service wifi_logger@%i.service
# 무선 iface(mlan0/mlan1) 전용 — wifi_logger@eth0 의 Wants= pull-in 은 조건 불충족으로
# 스킵된다(종전 wifi_logger_start.sh 의 iface 검증과 동일 의미).
ConditionPathIsDirectory=/sys/class/net/%i/wireless
# 영구 오류의 무한 재시작을 막되 일시 장애는 자동 복구한다.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/scripts/wifi_link_snapshot.sh %i
Restart=always
RestartSec=3
User=root
