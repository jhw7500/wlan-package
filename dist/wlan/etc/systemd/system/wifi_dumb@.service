[Unit]
Description=Wifi Dumb Service for %i (deprecated, use wifi_bridge@.service)
After=wifi_init.service
Requires=wifi_init.service
Conflicts=wifi_dumb@mlan0.service wifi_dumb@mlan1.service

[Service]
Type=simple
ExecStart=/usr/local/scripts/wifi_dumb.sh %i
Restart=always
RestartSec=1s

# Capabilities for dumb bridge (mlockall + RT scheduling + network)
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE CAP_IPC_LOCK
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE CAP_IPC_LOCK
NoNewPrivileges=yes

# Resource limits for mlockall() and RT scheduling
LimitMEMLOCK=infinity
LimitSTACK=16777216
LimitRTPRIO=50

[Install]
WantedBy=multi-user.target

