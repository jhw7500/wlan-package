[Unit]
Description=WiFi Periodic Roam Service for %i
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wpa_supplicant@%i.service
Wants=wpa_supplicant@%i.service

[Service]
ExecStart=/usr/local/scripts/wifi_periodic_roam.sh %i
Restart=on-failure
RestartSec=10s
User=root

[Install]
WantedBy=multi-user.target
