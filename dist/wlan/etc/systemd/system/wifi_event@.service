[Unit]
Description=WiFi event monitor for %i
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wifi_init.service
PartOf=wifi_init.service

[Service]
ExecStart=/usr/local/scripts/wifi_event.sh %i
Restart=on-failure
RestartSec=5s
User=root
# shell/job-control의 "Terminated" 같은 비구조화 출력이 rsyslog의 ^wifi_ 규칙을
# 통해 logger.log에 섞이지 않게 한다. 스크립트의 local0 logger 호출은 영향 없음.
StandardOutput=null
StandardError=null

[Install]
WantedBy=wifi-stack.target
