[Unit]
Description=WiFi Link Logger for %i (supervised — produces link.json for roaming)
# link.json(RSSI/supplicant 상태)은 wifi_roam 이 로밍 판정에 반드시 읽는 파일이다.
# 기존엔 wifi_logger_start.sh 가 & 백그라운드로 띄워 systemd 감독 밖에 있었고, 런타임에
# 죽으면 재시작되지 않아 로밍이 조용히 멈췄다. Type=simple + Restart=always 로 systemd 가
# 직접 감독·재시작해 단일 실패에도 자동 복구한다.
BindsTo=sys-subsystem-net-devices-%i.device
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wifi_init.service
# wifi_logger@%i / wifi_init 재시작·정지에 생명주기 연동(stop/restart 전파).
# wifi_logger@%i 의 Wants= 로 pull-in 되므로 [Install] 은 두지 않는다(엄격한 자식 유닛,
# 별도 systemctl enable 불필요 — 이중 활성화/순서 모호성 제거).
PartOf=wifi_init.service wifi_logger@%i.service
# 영구 오류의 무한 재시작을 막되 일시 장애는 자동 복구한다.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/bin/python3 /usr/local/logger/wifi_logger_link.py %i
Restart=always
RestartSec=3
# flock-loss(중복 실행 감지, link.py exit 3): 이미 다른 인스턴스가 link.json 을 생산
# 중이므로 정상 종료로 분류(SuccessExitStatus)하고 재시작하지 않는다(RestartPreventExitStatus).
# → 재시작 폭주 방지 + failed 상태 오탐(모니터링 노이즈) 방지.
SuccessExitStatus=3
RestartPreventExitStatus=3
User=root
