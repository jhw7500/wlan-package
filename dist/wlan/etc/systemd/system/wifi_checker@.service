[Unit]
Description=WiFi Checker Service for %i
DefaultDependencies=no
After=wifi_init.service sysinit.target
PartOf=wifi_init.service
Conflicts=shutdown.target
Before=shutdown.target

StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
ExecStart=/usr/local/scripts/wifi_checker.sh %i
Restart=always
RestartSec=5s
User=root

[Install]
WantedBy=multi-user.target
