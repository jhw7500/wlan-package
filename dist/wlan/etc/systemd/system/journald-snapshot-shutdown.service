[Unit]
Description=Snapshot journal at the end of service shutdown
# 셧다운 구간의 journal 을 eMMC 로 내보낸다(#371). systemd 는 셧다운 때 시작의 역순으로
# 정지하므로, sysinit.target 뒤에 시작하는 유닛(일반 서비스와, DefaultDependencies=no 이지만
# After=sysinit.target 인 wifi_checker@·wlan_fw_watch 등)보다 먼저 시작해 두면 그들이 모두
# 정지한 뒤에 이 유닛의 ExecStop 이 돈다. journald 와 내보내기 마운트는 그보다 뒤에
# 정지하도록 After= 로 둔다(둘 다 sysinit.target 보다 먼저 선다). /var/log 는 심볼릭
# 링크라 실제 마운트 경로도 함께 적는다(fake-hwclock.service 주석 참조).
# 부팅 완료 스냅샷은 journald-snapshot-boundary.service.
DefaultDependencies=no
After=systemd-journald.service local-fs.target
RequiresMountsFor=/var/volatile/log/cantops /var/log/cantops
Before=sysinit.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/scripts/journald_snapshot.sh
TimeoutStopSec=30

[Install]
WantedBy=sysinit.target
