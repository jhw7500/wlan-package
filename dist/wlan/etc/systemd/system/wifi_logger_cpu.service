[Unit]
Description=CPU and Memory Logger
After=wifi_init.service
PartOf=wifi_logger.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/log/cantops/cpu
ExecStart=/usr/local/scripts/wifi_logger_cpu.sh
Restart=always
RestartSec=3
User=root
StandardOutput=null
StandardError=null
