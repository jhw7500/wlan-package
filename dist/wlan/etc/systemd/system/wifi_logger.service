[Unit]
Description=System Logger Controller
After=wifi_init.service
Wants=wifi_logger_cpu.service wifi_logger_mmc.service wifi_logger_temp.service wifi_logger_mcp.service wifi_logger_summary.service

[Service]
Type=oneshot
ExecStart=/bin/true
RemainAfterExit=yes
StandardOutput=null
StandardError=null

[Install]
WantedBy=wifi-stack.target
