# /etc/systemd/system/fake-hwclock.service
[Unit]
Description=Restore and persist clock without RTC (fake-hwclock)
DefaultDependencies=no
Before=sysinit.target
# 상태 파일이 영속 파티션(/var/log/cantops)에 있으므로 마운트 후 load,
# 종료 시 언마운트 전 save가 보장되도록 마운트 의존을 건다.
# systemd의 경로→마운트유닛 변환은 심볼릭 링크를 따라가지 않는다. /var/log 는
# volatile/log 심볼릭 링크라, /var/log/cantops 로 적으면 존재하지 않는
# var-log-cantops.mount 로 변환돼 의존이 루트(-.mount)로 축소되고 load 가 파티션
# 마운트 '전에' 실행되어 restore 가 조용히 실패한다(→ 매 부팅 시각 역행 → 로그 중복).
# 실제 마운트 경로를 함께 명시해 마운트 후 load 를 보장한다.
RequiresMountsFor=/var/volatile/log/cantops /var/log/cantops
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/scripts/fake-hwclock.sh load
ExecStop=/usr/local/scripts/fake-hwclock.sh save

[Install]
WantedBy=sysinit.target
