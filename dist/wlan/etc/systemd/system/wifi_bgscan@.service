[Unit]
Description=WiFi Background Scan Service for %i
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wifi_init.service
PartOf=wifi_init.service

[Service]
ExecStart=/bin/python3 /usr/local/logger/wifi_bgscan.py %i
#Restart=always
User=root
#Type=oneshot
#RemainAfterExit=true

[Install]
WantedBy=multi-user.target

