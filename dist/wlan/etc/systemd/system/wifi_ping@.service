[Unit]
Description=WiFi Ping Service for %i
#Conflicts=wifi_ping@mlan0.service wifi_ping@mlan1.service
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wifi_init.service
PartOf=wifi_init.service

[Service]
Type=simple
ExecStart=/usr/local/scripts/wifi_ping.sh %i
#Restart=always
User=root
#Type=oneshot
#RemainAfterExit=true

[Install]
WantedBy=wifi-stack.target

