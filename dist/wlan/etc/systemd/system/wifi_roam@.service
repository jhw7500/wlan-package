[Unit]
Description=WiFi Roam Service for %i
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wifi_init.service
PartOf=wifi_init.service
# 재시작 rate-limit 무제한: roam 이 죽으면 RSSI 감시·후보 판정·로밍 실행이 통째로
# 멈춘다(연결은 유지되나 더 나은 AP 로 절대 못 옮김). 기본 제한(5회/10s)이면 연속
# 크래시 시 systemd 가 포기해 영구 미기동. (#118 wifi_logger_link, bgscan 과 동일 원리)
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/python3 /usr/local/logger/wifi_roam.py %i
# 런타임 사망(크래시/OOM) 시 자동 재시작 — 종전엔 Restart 주석 처리라 죽으면 그대로
# 정지했다. 형제 유닛(wifi_bgscan@:15, wifi_logger_link@:21)은 이미 감독 중인데 로밍
# 데몬만 빠져 있던 비대칭을 해소한다. PartOf=wifi_init.service 라 의도적 중지·재시작은
# systemd 가 Restart 대상에서 제외하므로 stack 제어와 충돌하지 않는다.
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=wifi-stack.target

