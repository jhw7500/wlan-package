[Unit]
Description=Ping Monitor Service for %i
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wpa_supplicant@%i.service
Wants=wpa_supplicant@%i.service

[Service]
ExecStart=/bin/python3 /usr/local/tools/ping-monitor/ping_monitor.py \
    -s -1 %i \
    -l /var/log/cantops/ping/%i/ping.log \
    -P
Restart=on-failure
RestartSec=10s
User=root

[Install]
WantedBy=multi-user.target
