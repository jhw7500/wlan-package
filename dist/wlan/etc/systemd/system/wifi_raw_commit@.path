[Unit]
Description=Watch WiFi raw switch save requests for %i
After=wifi_init.service
PartOf=wifi_init.service

[Path]
PathExists=/run/wifi/%i.raw-commit
Unit=wifi_raw_commit@%i.service
# Allow ordinary rapid switches while bounding retries if a worker cannot start.
TriggerLimitIntervalSec=30s
TriggerLimitBurst=30

[Install]
WantedBy=wifi-stack.target
