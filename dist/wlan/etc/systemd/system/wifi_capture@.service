[Unit]
Description=WiFi Capture Service for %i
BindsTo=sys-subsystem-net-devices-eth0.device sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-eth0.device sys-subsystem-net-devices-%i.device wifi_init.service
Wants=network-online.target
PartOf=wifi_init.service
#Conflicts=wifi_capture@mlan0.service wifi_capture@mlan1.service

[Service]
ExecStartPre=/bin/sleep 3
# 두 번째 인자 = 관리 프레임 subtype 제외(exclude) 마스크. bit N = subtype N (1이면 로그 제외).
# 0x4100 = bit8(0x0100) Beacon + bit14(0x4000) Action No Ack 제외, 나머지 관리 프레임은 전부 로깅.
# 전체 비트 테이블은 wifi_capture.py의 SUBTYPE_MASK 주석 참조.
#ExecStart=/bin/python3 /usr/local/logger/wifi_logger_cap.py %i 0x4100
ExecStart=/bin/python3 /usr/local/logger/wifi_capture.py %i 0x4100
#ExecStart=/usr/local/scripts/wifi_capture.sh %I
#Restart=always
User=root

[Install]
WantedBy=wifi-stack.target

