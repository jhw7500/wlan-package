[Unit]
Description=WiFi init Service
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
TimeoutStartSec=120
ExecStart=/usr/local/scripts/wifi_init.sh
ExecStop=systemctl stop wpa_supplicant@mlan0
ExecStop=systemctl stop wpa_supplicant@mlan1
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
