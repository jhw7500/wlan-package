[Unit]
Description=WiFi init Service
DefaultDependencies=no
After=local-fs.target sysinit.target
Wants=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target
# 실패 시 비상 복구 unit을 호출한다. 냉부팅 첫 MCS transitional status(75)는
# wlan_emergency_reboot.service의 ExecCondition이 제외하며 systemd가 10초 후 재시도한다.
# MAC 설정 실패(78)는 재시작/비상 reboot 없이 failed로 남긴다.
# 그 외 실패는 wlan_reboot_policy.sh의 uptime/cooldown 정책으로 판정한다.
OnFailure=wlan_emergency_reboot.service
# rmmod/insmod 실패 등 ExecStart 실패 시 짧은 간격으로 재시도. burst를 넘으면 정지.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
TimeoutStartSec=180
# ExecStart 실패(모듈 unload/load 실패 등)에서만 재시도. 정상 종료(success)는 재시도 안 함.
Restart=on-failure
RestartSec=10s
# MAC 설정/검증 실패는 운영자가 수정 후 restart한다. 잘못된 MAC으로 성공 처리하거나
# 같은 설정을 반복해 재부팅하지 않는다. status 75의 기존 transient retry는 유지한다.
RestartPreventExitStatus=78
# 1) JSON 구문/필수 구조 검증. 손상 시 마지막 정상본 또는 패키지 기본본으로 복구.
ExecStartPre=/usr/local/scripts/wifi_config_backup.sh restore
# 2) JSON이 선택한 사용자 calibration 파일을 검증하고 손상 시 정상본으로 복구.
ExecStartPre=/usr/local/scripts/wifi_cal_backup.sh protect
# 3) JSON *.enabled → systemctl enable/disable 동기화 (비정상 종료 후에도 일관 보장).
#    정상 reboot은 wifi_apply_enabled.service ExecStop도 동기화하므로 변경 없으면 idempotent (~100ms).
#    끄는 값인 PartOf=wifi_init 유닛은 이 시작 경로에서만 stop 한다(#458) — 재시작에 딸려 다시 잡힌
#    job 은 disable 이 취소하지 못한다. 다른 호출처(로거 CLI·postinst 등)는 이 변수를 넘기지 않는다.
#    실행 줄은 경로 그대로 둔다(env 접두를 붙이면 릴리스 게이트의 실행 대상 검사가 스크립트를 놓친다).
Environment=WIFI_APPLY_STOP_PARTOF=1
ExecStartPre=/usr/local/scripts/wifi_apply_enabled.sh
# 4) 모듈 로드 / 펌웨어 / MAC / 라디오 설정
ExecStart=/usr/local/scripts/wifi_init.sh
# 5) 초기화 성공 후에만 현재 JSON을 최신 정상본으로 확정. 백업 I/O 실패는 Wi-Fi 기동을 막지 않는다.
ExecStartPost=-/usr/local/scripts/wifi_config_backup.sh commit
# 6) enable된 자식 unit 일괄 start (stop은 자식 PartOf=wifi_init.service 자동 전파)
ExecStartPost=/usr/local/scripts/wifi_services.sh start
RemainAfterExit=yes

[Install]
WantedBy=wifi-stack.target
