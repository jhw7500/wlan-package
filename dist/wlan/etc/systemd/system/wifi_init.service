[Unit]
Description=WiFi init Service
DefaultDependencies=no
After=local-fs.target sysinit.target
Wants=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
TimeoutStartSec=180
ExecStart=/usr/local/scripts/wifi_init.sh
# 모듈 로드/펌웨어/MAC 설정이 끝난 뒤 enable된 자식 unit을 일괄 start한다.
# 자식 unit은 PartOf=wifi_init.service로 stop 전파만 받으므로, start는 이 스크립트가 책임진다.
ExecStartPost=/usr/local/scripts/wifi_services.sh start
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
