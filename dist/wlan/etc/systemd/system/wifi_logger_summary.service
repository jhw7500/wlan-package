[Unit]
Description=System WiFi Summary Logger
After=wifi_init.service
PartOf=wifi_logger.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/bin/python3 /usr/local/logger/wifi_logger_summary.py
Restart=always
RestartSec=3
User=root
StandardOutput=null
StandardError=null
