[Unit]
Description=System and WLAN Temperature Logger with Overtemperature Protection
After=wifi_init.service
PartOf=wifi_logger.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/scripts/wifi_logger_temp.sh
Restart=always
RestartSec=3
User=root
StandardOutput=null
StandardError=null
