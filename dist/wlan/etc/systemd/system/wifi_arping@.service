[Unit]
Description=Arping Service for %i
BindsTo=sys-subsystem-net-devices-%i.device
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device systemd-networkd.service wifi_init.service
PartOf=wifi_init.service
#After=network.target

[Service]
Type=simple
ExecStart=/usr/local/scripts/wifi_arping.sh %i
Restart=on-failure
RestartSec=10
User=root
#RemainAfterExit=true

[Install]
WantedBy=wifi-stack.target

