[Unit]
Description=Apply the signed factory record in eMMC boot1 to device_info.json before opcd and snmpd read it (#481)
Documentation=https://github.com/jhw7500/wlan-package/issues/481
# opcd-essid-restore.service 와 같은 층위(DefaultDependencies=no, local-fs 뒤)에서 부팅 때 한 번 돈다.
# opcd 는 시작할 때 한 번, SNMP 는 주기적으로 /usr/local/opc/etc/device_info.json 을 읽으므로 그보다
# 먼저 끝난다. boot1 하드웨어 파티션이 없는 보드는 실행 자체를 거른다.
DefaultDependencies=no
After=local-fs.target sysinit.target
Before=opcd.service snmpd.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/dev/mmcblk0boot1

[Service]
Type=oneshot
# exit 0: 레코드 유효(기록 또는 변경 없음)·레코드 없음. exit 1: 무효·모르는 키·판정 불가·기록 실패.
# 판정 규칙은 docs/devinfo_record_format.md 의 "부팅 검증 서비스". 어느 쪽도 opcd·snmpd 를 막지
# 않는다 — 두 유닛은 이 유닛을 Requires 하지 않고 순서만 따른다.
ExecStart=/usr/local/scripts/wifi_devinfo.py

[Install]
# opcd.service 와 같은 target. postinst 가 항상 enable 한다(.opc.enabled 게이트와 무관): SNMP 도
# 같은 파일을 읽는다.
WantedBy=multi-user.target
