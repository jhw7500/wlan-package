[Unit]
Description=Snapshot journal at boot completion
# multi-user.target 도달(부팅완료) 이후 ExecStart 실행.
# 셧다운 스냅샷은 journald-snapshot-shutdown.service 가 맡는다(#371): 이 유닛은 셧다운 때
# 서비스들보다 먼저 정지하므로 여기서 돌던 ExecStop 은 서비스 정지 구간을 담지 못했다.
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/scripts/journald_snapshot.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
