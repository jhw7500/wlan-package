# wbridge 서비스 설정 오버라이드 파일
# wifi_bridge@.service / wifi_thermal_state.service 의 EnvironmentFile로 로드됨
#
# 기본값은 /usr/local/etc/wifi_init_conf.json 의 "wbridge" 섹션에서 로드됩니다.
# 이 파일에서 설정 시 JSON 값을 덮어씁니다 (우선순위 높음).
#
# --- 마스터 스위치 ---
# WBRIDGE_ENABLED=1                 # 0=bridge 전체 비활성, 1=활성 (BRIDGE_IFACE와 독립)
#
# --- 엔진/프로필 ---
# WBRIDGE_ENGINE=pcap               # pcap | tpacket | moal (드라이버 bridge)
# WBRIDGE_PROFILE_VERSION=1
#
# --- 최적화 (optimize 그룹) ---
# WBRIDGE_OPTIMIZE=1                # 0=커널 튜닝 OFF, 1=ON
# WBRIDGE_MODE=normal               # latency | normal | eco | thermal
# WBRIDGE_IRQ_AFFINITY=auto         # auto | pinned | none
#
# --- 링크 가드 (link_guard 그룹) ---
# WBRIDGE_LINK_GUARD=1              # 0=OFF, 1=ON
# WBRIDGE_LINK_DOWN_DEBOUNCE_SEC=2
# WBRIDGE_LINK_UP_STABLE_SEC=2
# WBRIDGE_LINK_IDLE_POLL_SEC=5
# WBRIDGE_WAIT_READY_TIMEOUT_SEC=10
# WBRIDGE_WLAN_ROAM_GRACE_SEC=15
# WBRIDGE_WLAN_DOWN_RESTART=0
#
# --- Thermal (thermal 그룹) ---
# WBRIDGE_MODE_FORCE=1              # 1=thermal 클램핑 무시
# WBRIDGE_THERMAL_AUTO_RESTART=0
# WBRIDGE_THERMAL_TIMER_ENABLE=0
# WBRIDGE_THERMAL_RESTART_COOLDOWN_SEC=60
