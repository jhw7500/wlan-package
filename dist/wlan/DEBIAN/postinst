#!/bin/bash

############################################################
# postinst script main
############################################################
# Include debconf library.
tag=$(basename "$0")
KEY=PKG
PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"
KERNEL_VERSION=$(uname -r)
# Get hostname from system or use default
#hostname=$(hostname 2>/dev/null || echo "cantops-device")
hostname="cts-wlan"
DEBCONF_AVAILABLE=0
if [ -r /usr/share/debconf/confmodule ]; then
  . /usr/share/debconf/confmodule
  DEBCONF_AVAILABLE=1
fi

INSTALL_DOT_COUNT=0

disable_services_if_enabled() {
    local services=("$@")
    for svc in "${services[@]}"; do
        local svc_clean="${svc%.service}"
        echo "[INFO] Checking service: $svc_clean"

        if command -v systemctl >/dev/null 2>&1; then
            if systemctl is-enabled --quiet "$svc_clean"; then
                echo "[INFO] Disabling $svc_clean (via systemctl)"
                systemctl disable "$svc_clean"
            else
                echo "[INFO] $svc_clean is already disabled"
            fi
        else
            echo "[WARN] systemctl not available, skipping disable for $svc_clean"
        fi
    done
}

case "$1" in
configure)
  echo "postinst configure"
  /usr/local/logger/print.py green "\r\n[installer] start: configuration copy/verify..."

  # CRITICAL: Verify binaries and config exist BEFORE making any system changes.
  # 보드별 suffix(_imx8/_imx93) 바이너리 또는 legacy suffix-less 중 하나 이상 필요.
  # 실제 보드 분기는 아래 BOARD_TYPE detection 후 심볼릭 링크 단계에서 처리.
  _has_wbridge=0
  for cand in wbridge wbridge_imx8 wbridge_imx93; do
    [ -f "/usr/local/wlan-bridge/wbridge/${cand}" ] && _has_wbridge=1 && break
  done
  if [ "$_has_wbridge" -ne 1 ]; then
    echo "ERROR: no wbridge binary in /usr/local/wlan-bridge/wbridge/ (wbridge, wbridge_imx8, wbridge_imx93)" >&2
    logger -p local0.err "[$tag:$LINENO] [$KEY] Critical: no wbridge binary present"
    exit 1
  fi
  _has_tpacket=0
  for cand in wbridge-tpacket wbridge-tpacket_imx8 wbridge-tpacket_imx93; do
    [ -f "/usr/local/wlan-bridge/wbridge/${cand}" ] && _has_tpacket=1 && break
  done
  if [ "$_has_tpacket" -ne 1 ]; then
    echo "ERROR: no wbridge-tpacket binary in /usr/local/wlan-bridge/wbridge/" >&2
    logger -p local0.err "[$tag:$LINENO] [$KEY] Critical: no wbridge-tpacket binary present"
    exit 1
  fi

  mkdir -p /usr/local/etc

  # 0.5.1 이전 패키지가 payload로 설치했던 개발용 테스트/cache는 새 패키지에서
  # 제거해도 Python이 만든 비소유 파일 때문에 dpkg가 빈 디렉터리를 지우지 못할 수 있다.
  # 운영 경로 아래의 알려진 개발 전용 위치만 표적 삭제한다.
  rm -rf -- \
    /usr/local/logger/tests \
    /usr/local/logger/__pycache__ \
    /usr/local/scripts/tests \
    /usr/local/scripts/__pycache__

  cp /opt/wlan/config/logrotate.d/logrotate.rsyslog /etc/logrotate.d/

  # wlan 전용 logrotate hourly 실행 스크립트 설치
  # 시스템 전체 logrotate(/etc/cron.daily/logrotate)는 건드리지 않고
  # wlan 관련 설정만 hourly로 실행하여 maxsize가 실질적으로 동작하도록 함
  mkdir -p /etc/cron.hourly
  cat > /etc/cron.hourly/logrotate-wlan << 'EOF'
#!/bin/sh
# wlan 전용 hourly logrotate (시스템 전체 logrotate와 독립)
/usr/sbin/logrotate /etc/logrotate.d/logrotate.rsyslog
EOF
  chmod 755 /etc/cron.hourly/logrotate-wlan
  cp /opt/wlan/config/rsyslog.conf /etc/
  cp /opt/wlan/config/smb.conf /etc/samba/
  cp /opt/wlan/config/wifi_mod_para__.conf /lib/firmware/nxp/
  cp /opt/wlan/config/crontab /etc/
  cp /opt/wlan/config/wpa_supplicant/wpa_supplicant@.service /lib/systemd/system/
  cp /opt/wlan/config/systemd/journald.conf /etc/systemd/
  mkdir -p /etc/snmp
  cp /opt/wlan/config/snmp/snmpd.conf /etc/snmp/snmpd.conf
  # snmpd 라이프사이클은 wifi_init_conf.json .snmp.enabled 게이트가 소유
  # (wifi_apply_enabled.sh enable/disable + wifi_services.sh start).
  # 업그레이드 시 백엔드가 /usr/local/scripts → /usr/local/logger 로 이동하고 snmpd.conf 도
  # 갱신되므로, 실행 중이던 snmpd(구 경로를 메모리에 유지)를 .snmp.enabled 에 맞춰 정리한다.
  if command -v systemctl >/dev/null 2>&1; then
    # 신규 drop-in(snmpd.service.d/override.conf)을 systemd 가 인지하도록 snmpd 제어 전에 reload.
    systemctl daemon-reload 2>/dev/null || true
    _snmp_on=false
    if command -v jq >/dev/null 2>&1 && [ -f /usr/local/etc/wifi_init_conf.json ]; then
      _snmp_on=$(jq -r 'if .snmp.enabled == true then "true" else "false" end' \
                 /usr/local/etc/wifi_init_conf.json 2>/dev/null || echo false)
    fi
    if [ "$_snmp_on" = "true" ]; then
      # opt-in 유지: 실행 중이면 새 설정(logger 경로)으로 재시작해 모니터링 다운 방지
      # (enable 복원은 부팅 시 wifi_apply_enabled.sh 가 담당, 정지 상태면 no-op).
      systemctl try-restart snmpd 2>/dev/null || true
    else
      # opt-out(기본): 배포판 기본 enable 중화 + 구 경로 참조/161 노출 제거 위해 정지.
      disable_services_if_enabled snmpd
      systemctl stop snmpd 2>/dev/null || true
    fi
  fi

  # 부팅 중 oneshot(wifi_install.service) 안에서 journald를 restart하면 이 스크립트의
  # 로그 소켓이 끊긴다. 새 journald.conf/rsyslog.conf는 다음 부팅에 자연히 적용되므로
  # journald restart는 제거하고, rsyslog는 --no-block로 잡 대기 없이 재시작한다.
  systemctl --no-block restart rsyslog 2>/dev/null || true

  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
  fi

  # wifi_dumb@.service is deprecated (replaced by wifi_bridge@.service).
  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now \
      wifi_dumb@mlan0 \
      wifi_dumb@mlan1 \
      wifi_dumb@eth0 \
      2>/dev/null || true
    systemctl mask wifi_dumb@.service 2>/dev/null || true
    systemctl reset-failed \
      wifi_dumb@mlan0 \
      wifi_dumb@mlan1 \
      wifi_dumb@eth0 \
      2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
  fi

  SAFE_TIME="2026-01-01 00:00:00"
  CURRENT_TS=$(date +%s)
  SAFE_TS=$(date -d "$SAFE_TIME" +%s 2>/dev/null || echo 1767225600)
  echo "date : $(date '+%Y-%m-%d %H:%M:%S')"

  if [ "$CURRENT_TS" -lt "$SAFE_TS" ]; then
    echo "WARNING: System time is before $SAFE_TIME, setting to safe time"
    timedatectl set-ntp false 2>/dev/null || true
    timedatectl set-timezone Asia/Seoul 2>/dev/null || true
    timedatectl set-time "$SAFE_TIME" 2>/dev/null || true
  else
    timedatectl set-timezone Asia/Seoul 2>/dev/null || true
  fi

  # Locale: C → C.UTF-8 (한글 바이트 정상 처리, 별도 로케일 생성 불필요)
  if [ "$(cat /etc/locale.conf 2>/dev/null)" != "LANG=C.UTF-8" ]; then
    echo 'LANG=C.UTF-8' > /etc/locale.conf 2>/dev/null || true
    logger -p local0.info "[$tag:$LINENO] [$KEY] Set default locale to C.UTF-8"
  fi

  # Detect board type via SoC ID.
  # 감지 로직은 wifi_board_config.sh에 두고 factory_reset.sh와 공유한다 — 양쪽이 갈라지면
  # factory_reset 후 보드와 맞지 않는 설정이 남는다.
  BOARD_CONFIG_SH="/usr/local/scripts/wifi_board_config.sh"
  if [ -x "$BOARD_CONFIG_SH" ]; then
    eval "$("$BOARD_CONFIG_SH" --detect)"
  fi

  # 헬퍼가 없거나(패키지 손상) --detect 출력이 깨져 변수가 안 잡히면 여기서 직접 감지한다.
  # 감지를 건너뛰고 고정값으로 진행하면 BOARD_TYPE이 실제 보드와 어긋나 드라이버/바이너리가
  # 불일치하므로, 폴백도 반드시 soc_id를 읽어야 한다.
  # 세 변수를 모두 검사한다: BOARD_TYPE은 아래 wbridge 심볼릭 링크 단계에서도 쓰여 빈 값이면
  # dangling symlink가 되고, BUS_TYPE이 빈 문자열로 JSON에 박히면 소비 측의 `// "pcie"` 기본값이
  # 걸리지 않는다(jq의 //는 null/false에만 반응하고 ""는 통과시킨다).
  board_detect_ok=0
  case "${BOARD_TYPE:-}" in
    imx93|imx8mm) [ -n "${BUS_TYPE:-}" ] && [ -n "${IIO_DEV:-}" ] && board_detect_ok=1 ;;
  esac

  if [ "$board_detect_ok" -ne 1 ]; then
    logger -p local0.err "[$tag:$LINENO] [$KEY] board detect via $BOARD_CONFIG_SH failed (BOARD_TYPE='${BOARD_TYPE:-}' BUS_TYPE='${BUS_TYPE:-}' IIO_DEV='${IIO_DEV:-}'); detecting inline"
    SOC_ID=$(cat /sys/devices/soc0/soc_id 2>/dev/null || echo "")
    if echo "$SOC_ID" | grep -qi "i\.MX93"; then
      BOARD_TYPE="imx93"
      BUS_TYPE="sdio"
      IIO_DEV="/sys/bus/iio/devices/iio:device1"
    else
      BOARD_TYPE="imx8mm"
      BUS_TYPE="pcie"
      IIO_DEV="/sys/bus/iio/devices/iio:device0"
    fi
  fi

  # Detect eMMC block device number (iMX8MM: mmcblk2, iMX93: mmcblk0)
  if [ -d /sys/block/mmcblk2 ]; then
    EMMC_NUM=2
  else
    EMMC_NUM=0
  fi

  /usr/local/logger/print.py green "\r\n[installer] preparing data partition (resize, wait)..."
  # p3 파티션이 없으면 emmc_fdisk.sh로 생성
  if [ ! -b /dev/mmcblk${EMMC_NUM}p3 ]; then
    logger -p local0.info "[postinst:$LINENO] [$KEY] p3 not found, creating via emmc_fdisk.sh"
    /usr/local/scripts/emmc_fdisk.sh
  else
    /usr/local/scripts/auto_fs_sizeup.sh "$EMMC_NUM" 3
  fi

customctl() {
    target=$1
    daemon_name=$2
    status=$(systemctl is-enabled $daemon_name 2>/dev/null)
    if [[ $status != ${target}* ]]; then
        if [[ $target = enable* ]]; then
            systemctl enable $daemon_name
        elif [[ $target = disable* ]]; then
            if [[ $status != mask* ]]; then
                systemctl disable --now $daemon_name
            fi
        elif [[ $target = mask* ]]; then
            systemctl disable --now $daemon_name
            systemctl mask $daemon_name
        else
            echo "$target is wrong status"
            return 1
        fi
    fi
    status=$(systemctl is-enabled $daemon_name 2>/dev/null)
    echo "$daemon_name is $status"
    INSTALL_DOT_COUNT=$((INSTALL_DOT_COUNT + 1))
    dots=$(printf "%${INSTALL_DOT_COUNT}s" | tr ' ' '.')
    /usr/local/logger/print.py green "\r\n[installer] installing${dots}"
}
  if [ -f /etc/init.d/samba ]; then
    mv /etc/init.d/samba /etc/init.d/samba.disabled
  fi

  # Ensure default target is multi-user.target (services won't auto-start under graphical or other targets)
  current_target=$(systemctl get-default 2>/dev/null || echo "unknown")
  if [ "$current_target" != "multi-user.target" ]; then
    echo "[INFO] Default target is '$current_target', changing to multi-user.target"
    systemctl set-default multi-user.target 2>/dev/null || true
    logger -p local0.info "[$tag:$LINENO] [$KEY] Changed default target from '$current_target' to multi-user.target"
  fi

  echo "[installer] Optimizing service configuration (batch processing)..."
  systemctl mask systemd-networkd-wait-online nfs-server proc-fs-nfsd.mount ovsdb-server avahi-daemon avahi-autoipd psplash systemd-journald-audit.socket netplan-ovs-cleanup || true
  systemctl disable --now dhcpcd openvswitch openvswitch-switch connman smb nmb avahi-daemon.socket containerd netdata collectd named systemd-resolved netserver wifi_checker@eth0 || true

  # 업그레이드 경로: 구버전에서 WantedBy=multi-user.target 이었던 wifi_* 유닛들의
  # 구 심볼릭 링크를 정리한다. 새 버전은 WantedBy=wifi-stack.target.
  # wifi_apply_enabled.service 는 shutdown ExecStop 동기화 목적으로 multi-user.target 유지.
  # 정리 후 아래 systemctl enable 이 새 WantedBy 기반으로 링크를 재생성한다.
  for _old_link in /etc/systemd/system/multi-user.target.wants/wifi_*.service; do
      [ -L "$_old_link" ] || continue
      _unit_name=$(basename "$_old_link" 2>/dev/null)
      [ "$_unit_name" = "wifi_apply_enabled.service" ] && continue
      rm -f "$_old_link" 2>/dev/null || true
  done
  systemctl daemon-reload 2>/dev/null || true

  # 시스템 unit + wifi 진입점(wifi_init/wifi_apply_enabled) + 기본 복구 unit을 먼저
  # enable한다. wifi_logger 글로벌/eth0의 최종 부팅 정책은 아래
  # wifi_apply_enabled.sh가 JSON(.logger.enabled/.eth0.logger.enabled)과 동기화한다.
  # wifi-stack.target 은 multi-user.target 도달 후 비블로킹으로 wifi 스택을 기동한다.
  /usr/local/logger/print.py green "\r\n[installer] enabling services..."
  systemctl enable watchdog switchd fake-hwclock fake-hwclock.timer journald-snapshot.timer journald-snapshot-boundary.service wifi-stack.target wifi_init wifi_apply_enabled wifi_logger wifi_led@eth0 wifi_logger@eth0 wifi_led@mlan0 log-watchdog.timer serial-getty@ttyGS0.service || true
  # serial-getty@ttyGS0는 커널 콘솔이자 이 설치 로그 출력 대상이라 동기 start가
  # 위험하다(PID1 잡 대기와 맞물려 데드락 가능). --no-block로 큐잉만 하고 진행한다.
  systemctl start --no-block switchd wifi_led@eth0 serial-getty@ttyGS0.service || true

  # wifi 자식 데몬 (wifi_logger@mlanN, wifi_checker@, wifi_bgscan@, wifi_roam@, wifi_arping@,
  # wifi_periodic_roam@, wifi_event@, wifi_bridge@, wpa_supplicant@, wifi_ping_monitor,
  # wifi_thermal_state.timer, wifi_mgmt_log.timer)는 wifi_init_conf.json의 *.enabled 키에
  # 따라 wifi_apply_enabled.sh가 일괄 enable/disable한다.
  #
  # opcd (wlan-opc: OPC-side UDP control plane, spec Rev1.00 §3): 원본 unit 은
  # /usr/local/opc/opcd.service 단일 트리에 두고 systemd 표준 위치로 symlink 만 만든다.
  # 라이프사이클(enable/disable/start)은 wifi_init_conf.json .opc.enabled 게이트가 소유한다
  # (아래 wifi_apply_enabled.sh enable/disable + 부팅 wifi_services.sh start). 심링크는
  # apply_enabled 호출 전에 존재해야 설치 시점 enable/disable 이 동작하므로 이 위치에 둔다.
  if [ -f /usr/local/opc/opcd.service ]; then
    ln -sf /usr/local/opc/opcd.service /etc/systemd/system/opcd.service
    systemctl daemon-reload 2>/dev/null || true
    logger -p local0.info "[$tag:$LINENO] [$KEY] opcd.service installed via symlink (.opc.enabled 게이트로 제어)"
  fi
  /usr/local/scripts/wifi_apply_enabled.sh 2>/dev/null || true

  INSTALL_DOT_COUNT=$((INSTALL_DOT_COUNT + 10))
  dots=$(printf "%${INSTALL_DOT_COUNT}s" | tr ' ' '.')
  /usr/local/logger/print.py green "\r\n[installer] installing${dots}"

makeDirectory() {
    if [ ! -d "$1" ]; then
        echo "Creating $1 directory..."
        mkdir -p "$1"
        if [ $? -eq 0 ]; then
            echo "Directory $1 created successfully."
        else
            logger -s -p local0.err "[$tag:$LINENO] [$KEY] Failed to create $1 directory."
            exit 1
        fi
    else
        echo "$1 directory already exists."
    fi
}
  makeDirectory /etc/wpa_supplicant
  makeDirectory /usr/local/mfg
  makeDirectory /usr/local/bin
  makeDirectory /usr/local/logger
  makeDirectory /usr/local/scripts
  makeDirectory /usr/local/etc
  makeDirectory /usr/lib/sysctl.d
  makeDirectory /var/log/cantops/mgmt/mlan0
  makeDirectory /var/log/cantops/mgmt/mlan1

  # 0.5.1 개발 중 임시 도입된 별도 overlay는 더 이상 설정원으로 사용하지 않는다.
  # 업그레이드 장비에서도 wifi_init_conf.json 하나만 남도록 active 잔재를 제거한다.
  rm -f -- /usr/local/etc/config.json

  echo "set hostname:$hostname"
  echo "$hostname" > /etc/hostname
  sed -i "2s/.*/127.0.1.1 $hostname/" /etc/hosts

  INSTALL_DOT_COUNT=$((INSTALL_DOT_COUNT + 1))
  dots=$(printf "%${INSTALL_DOT_COUNT}s" | tr ' ' '.')
  /usr/local/logger/print.py green "\r\n[installer] installing${dots}"

cpchk() {
  # 0바이트 파일도 "없음"으로 간주 (이전 설치의 ext4 power-cut 잔재 자동 복구).
  # 모든 cp 직후 per-file sync로 ext4 메타/데이터 동기화 갭을 차단한다.
  if [ ! -s "$2" ]; then
    logger -s -p local0.info "[$tag:$LINENO] [$KEY] cp $1 $2 (target empty or missing)"
    cp "$1" "$2"
    sync "$2" 2>/dev/null || sync
  fi
}

# JSON deep merge: 새 키는 기본값에서 추가, 기존 키는 사용자 값 유지
atomic_json_install() {
  local content="$1" active="$2" dir tmp
  dir=$(dirname "$active")
  mkdir -p "$dir" || return 1
  tmp=$(mktemp "${active}.merge.XXXXXX") || return 1
  if ! printf '%s\n' "$content" > "$tmp" || ! jq empty "$tmp" >/dev/null 2>&1; then
    rm -f -- "$tmp"
    return 1
  fi
  chmod 0644 "$tmp" || { rm -f -- "$tmp"; return 1; }
  chown root:root "$tmp" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  sync "$tmp" 2>/dev/null || sync
  if ! mv -f -- "$tmp" "$active"; then
    rm -f -- "$tmp"
    return 1
  fi
  sync "$active" 2>/dev/null || sync
  sync "$dir" 2>/dev/null || sync
}

json_merge() {
  local default="$1" active="$2"
  if [ ! -f "$active" ]; then
    local merged
    merged=$(cat "$default" 2>/dev/null) || return 1
    if atomic_json_install "$merged" "$active"; then
      logger -s -p local0.info "[$tag:$LINENO] [$KEY] installed $default -> $active"
    else
      logger -p local0.err "[$tag:$LINENO] [$KEY] initial JSON install failed: $default -> $active"
      return 1
    fi
  elif command -v jq >/dev/null 2>&1; then
    local merged
    merged=$(jq -s '.[0] * .[1]' "$default" "$active" 2>/dev/null)
    if [ -n "$merged" ]; then
      if atomic_json_install "$merged" "$active"; then
        logger -p local0.info "[$tag:$LINENO] [$KEY] json_merge $default -> $active"
      else
        logger -p local0.err "[$tag:$LINENO] [$KEY] atomic json_merge write failed; keep existing $active"
        return 1
      fi
    else
      logger -p local0.warn "[$tag:$LINENO] [$KEY] json_merge failed; keep existing $active"
    fi
  else
    logger -p local0.warn "[$tag:$LINENO] [$KEY] jq not found; skip json_merge for $active"
  fi
}

# deep merge는 기존 사용자 키를 보존하므로, 코드에서 폐기한 노브는 명시적으로 지운다.
# 제거하지 않으면 업그레이드 장비의 JSON/WebUI에 무효 설정이 영구히 남아 오해를 만든다.
cleanup_retired_roaming_keys() {
  local active="$1" tmp
  [ -f "$active" ] || return 0
  if ! command -v jq >/dev/null 2>&1; then
    logger -p local0.warn "[$tag:$LINENO] [$KEY] jq not found; skip retired roaming key cleanup"
    return 0
  fi

  tmp="${active}.cleanup.$$"
  if jq 'del(
      .mlan0.roaming.STAGED_SCAN.cache_fresh_sec,
      .mlan0.roaming.STAGED_SCAN.self_induced_tail_sec,
      .mlan0.roaming.STAGED_SCAN._comment,
      .mlan0.roaming.GOOD_SIGNAL_RESET_GATE.delta_db,
      .mlan0.roaming.GOOD_SIGNAL_RESET_GATE.post_roam_grace_sec,
      .mlan0.roaming.GOOD_SIGNAL_RESET_GATE._comment,
      .mlan0.roaming.CACHE_FRESH_SEC,
      .mlan0.roaming.SELF_INDUCED_TAIL_SEC,
      .mlan0.roaming.GOOD_SIGNAL_GATE_DELTA_DB,
      .mlan0.roaming.GOOD_SIGNAL_GATE_GRACE_SEC,
      .mlan0.roaming.LOAD_BASED_ROAM,
      .mlan0.roaming.ADAPTIVE_INTERVAL,
      .mlan0.roaming.POST_ROAM_ARP_OPTIMIZATION,
      .mlan1.roaming.STAGED_SCAN.cache_fresh_sec,
      .mlan1.roaming.STAGED_SCAN.self_induced_tail_sec,
      .mlan1.roaming.STAGED_SCAN._comment,
      .mlan1.roaming.GOOD_SIGNAL_RESET_GATE.delta_db,
      .mlan1.roaming.GOOD_SIGNAL_RESET_GATE.post_roam_grace_sec,
      .mlan1.roaming.GOOD_SIGNAL_RESET_GATE._comment,
      .mlan1.roaming.CACHE_FRESH_SEC,
      .mlan1.roaming.SELF_INDUCED_TAIL_SEC,
      .mlan1.roaming.GOOD_SIGNAL_GATE_DELTA_DB,
      .mlan1.roaming.GOOD_SIGNAL_GATE_GRACE_SEC,
      .mlan1.roaming.LOAD_BASED_ROAM,
      .mlan1.roaming.ADAPTIVE_INTERVAL,
      .mlan1.roaming.POST_ROAM_ARP_OPTIMIZATION
    )
    | if (.mlan0.roaming.STAGED_SCAN | type) == "object" then
        .mlan0.roaming.STAGED_SCAN |= with_entries(select(.key | startswith("_comment") | not))
      else . end
    | if (.mlan0.roaming.GOOD_SIGNAL_RESET_GATE | type) == "object" then
        .mlan0.roaming.GOOD_SIGNAL_RESET_GATE |= with_entries(select(.key | startswith("_comment") | not))
      else . end
    | if (.mlan1.roaming.STAGED_SCAN | type) == "object" then
        .mlan1.roaming.STAGED_SCAN |= with_entries(select(.key | startswith("_comment") | not))
      else . end
    | if (.mlan1.roaming.GOOD_SIGNAL_RESET_GATE | type) == "object" then
        .mlan1.roaming.GOOD_SIGNAL_RESET_GATE |= with_entries(select(.key | startswith("_comment") | not))
      else . end' \
    "$active" > "$tmp"; then
    chmod 0644 "$tmp"
    chown root:root "$tmp" 2>/dev/null || true
    mv "$tmp" "$active"
    sync "$active" 2>/dev/null || sync
    logger -p local0.info "[$tag:$LINENO] [$KEY] removed retired roaming keys from $active"
  else
    rm -f "$tmp"
    logger -p local0.warn "[$tag:$LINENO] [$KEY] retired roaming key cleanup failed; keep $active"
  fi
}

# mlan1 conf 의 활성 bgscan 은 supplicant 자율 로밍을 발화시켜 외부 roam 데몬과 Roaming
# notify 경로를 우회한다. 템플릿에서는 제거했지만 cpchk 는 기존 /etc 복사본을 보존하므로,
# 업그레이드 장비에서도 해당 라인만 표적 제거한다(사용자 관리 필드는 그대로 둔다).
cleanup_mlan1_supplicant_bgscan() {
  local conf="$1"
  [ -f "$conf" ] || return 0
  grep -q '^[[:space:]]*bgscan=' "$conf" || return 0
  if sed -i '/^[[:space:]]*bgscan=/d' "$conf"; then
    sync "$conf" 2>/dev/null || sync
    logger -p local0.info "[$tag:$LINENO] [$KEY] removed active bgscan line from $conf"
  else
    logger -p local0.warn "[$tag:$LINENO] [$KEY] failed to remove bgscan line from $conf"
  fi
}

secure_wpa_conf() {
  local conf="$1"
  [ -f "$conf" ] || return 1
  chown root:root "$conf" 2>/dev/null || return 1
  chmod 0600 "$conf" || return 1
  sync "$conf" 2>/dev/null || sync
}

  cpchk /opt/wlan/mfg/bridge_init.conf /usr/local/mfg/bridge_init.conf
  cpchk /opt/wlan/config/systemd/timesyncd.conf /etc/systemd/timesyncd.conf
  cpchk /opt/wlan/config/wpa_supplicant/wpa_supplicant-mlan0.conf /etc/wpa_supplicant/wpa_supplicant-mlan0.conf
  cpchk /opt/wlan/config/wpa_supplicant/wpa_supplicant-mlan1.conf /etc/wpa_supplicant/wpa_supplicant-mlan1.conf
  cleanup_mlan1_supplicant_bgscan /etc/wpa_supplicant/wpa_supplicant-mlan1.conf
  secure_wpa_conf /etc/wpa_supplicant/wpa_supplicant-mlan0.conf || exit 1
  secure_wpa_conf /etc/wpa_supplicant/wpa_supplicant-mlan1.conf || exit 1
  cpchk /opt/wlan/config/systemd/network/20-mlan0.network /etc/systemd/network/20-mlan0.network
  cpchk /opt/wlan/config/systemd/network/21-mlan1.network /etc/systemd/network/21-mlan1.network
  cpchk /opt/wlan/config/systemd/network/22-eth0.network /etc/systemd/network/22-eth0.network
  cpchk /opt/wlan/config/systemd/network/10-lo.network /etc/systemd/network/10-lo.network
  cpchk /opt/wlan/config/systemd/network/20-mlan0.link /etc/systemd/network/20-mlan0.link
  cpchk /opt/wlan/config/systemd/network/21-mlan1.link /etc/systemd/network/21-mlan1.link
  cpchk /opt/wlan/config/systemd/network/22-eth0.link /etc/systemd/network/22-eth0.link
  json_merge /opt/wlan/config/wifi_init_conf.json /usr/local/etc/wifi_init_conf.json || exit 1
  cleanup_retired_roaming_keys /usr/local/etc/wifi_init_conf.json

  # json_merge 이후 보드별 설정 적용 (첫 설치 시에도 정상 동작).
  # 헬퍼가 없으면 위에서 인라인 감지한 값을 그대로 주입한다 — 이 단계를 건너뛰면 JSON에는
  # 템플릿의 고정값(BOARD_TYPE=imx93)만 남고 .mcp.iio_device가 부재해, shell 변수와 JSON이
  # 어긋나고 iMX93에서 Invalid Voltage 버그가 그대로 재현된다.
  WIFI_CONF="/usr/local/etc/wifi_init_conf.json"
  board_applied=0
  if [ -x "$BOARD_CONFIG_SH" ]; then
    if "$BOARD_CONFIG_SH" "$WIFI_CONF"; then
      board_applied=1
    else
      logger -p local0.err "[postinst:$LINENO] [$KEY] board config apply failed: $WIFI_CONF"
    fi
  fi

  # 헬퍼가 없을 때뿐 아니라 '있는데 실패한' 경우에도 인라인으로 재시도한다. 이 단계를 건너뛰면
  # JSON에 .mcp.iio_device가 없는 채로 남아 원 버그(Invalid Voltage 무한 로깅)가 조용히 재현된다.
  if [ "$board_applied" -ne 1 ] && [ -f "$WIFI_CONF" ] && command -v jq >/dev/null 2>&1; then
    # jq의 stderr는 버리지 않고 캡처해 실패 원인(JSON 구문 오류 등)을 로그로 남긴다.
    # `2>&1 > file`은 stderr를 명령치환으로, stdout을 파일로 보낸다 (순서 중요).
    jq_err=$(jq --arg b "$BOARD_TYPE" --arg bus "$BUS_TYPE" --arg iio "$IIO_DEV" \
               '.global.BOARD_TYPE = $b | .global.BUS_TYPE = $bus | .global.MOD_PARA = "cts/wifi_mod_para.conf" | .mcp.iio_device = $iio' \
               "$WIFI_CONF" 2>&1 > "${WIFI_CONF}.tmp")
    if [ -z "$jq_err" ] && [ -s "${WIFI_CONF}.tmp" ]; then
      mv "${WIFI_CONF}.tmp" "$WIFI_CONF"
      sync "$WIFI_CONF" 2>/dev/null || sync
      logger -p local0.warn "[postinst:$LINENO] [$KEY] board config injected inline ($BOARD_TYPE); helper unavailable or failed"
    else
      rm -f "${WIFI_CONF}.tmp"
      logger -p local0.err "[postinst:$LINENO] [$KEY] inline board config injection failed: $WIFI_CONF: ${jq_err:-empty output}"
    fi
  fi

  # 첫 부팅 전에 보드 정보까지 반영된 설정을 정상본으로 선제 저장한다. 업그레이드에서는
  # 기존 정상본과 내용이 같으면 회전하지 않으며, 손상된 active는 commit이 거부한다.
  if [ -x /usr/local/scripts/wifi_config_backup.sh ]; then
    /usr/local/scripts/wifi_config_backup.sh commit \
      || logger -p local0.err "[$tag:$LINENO] [$KEY] initial wifi_init_conf backup failed: $WIFI_CONF"
  else
    logger -p local0.err "[$tag:$LINENO] [$KEY] missing wifi_config_backup.sh; initial JSON backup skipped"
  fi
  # 업그레이드 전에 등록된 사용자 calibration도 첫 부팅 전 정상본을 확보한다.
  if [ -x /usr/local/scripts/wifi_cal_backup.sh ]; then
    /usr/local/scripts/wifi_cal_backup.sh protect \
      || logger -p local0.err "[$tag:$LINENO] [$KEY] initial custom calibration backup failed"
  else
    logger -p local0.err "[$tag:$LINENO] [$KEY] missing wifi_cal_backup.sh; custom calibration backup skipped"
  fi

  if [ -f /opt/wlan/config/sysctl.d/99-wifi-thermal.conf ]; then
    cp /opt/wlan/config/sysctl.d/99-wifi-thermal.conf /usr/lib/sysctl.d/99-wifi-thermal.conf
    logger -p local0.info "[$tag:$LINENO] [$KEY] Installed /usr/lib/sysctl.d/99-wifi-thermal.conf"
  else
    logger -p local0.warn "[$tag:$LINENO] [$KEY] Missing /opt/wlan/config/sysctl.d/99-wifi-thermal.conf"
  fi

  INSTALL_DOT_COUNT=$((INSTALL_DOT_COUNT + 1))
  dots=$(printf "%${INSTALL_DOT_COUNT}s" | tr ' ' '.')
  /usr/local/logger/print.py green "\r\n[installer] create symlinks..."

  # SysV generator 비활성화 (부팅 로그 정리)
  # 원본이 존재하면 백업 후 mask
  if [ -f /lib/systemd/system-generators/systemd-sysv-generator ] && [ ! -L /lib/systemd/system-generators/systemd-sysv-generator ]; then
      cp -a /lib/systemd/system-generators/systemd-sysv-generator /lib/systemd/system-generators/systemd-sysv-generator.orig
  fi
  ln -sf /dev/null /lib/systemd/system-generators/systemd-sysv-generator
  # Create symlinks for wlan-bridge binaries (wbridge) — board별 분기.
  # cross-build 시 wbridge_imx8 / wbridge_imx93 두 가지가 모두 설치되며,
  # postinst가 보드 감지(BOARD_TYPE)에 따라 /usr/local/bin/wifi-wbridge 가
  # 해당 보드 바이너리를 가리키도록 심볼릭 링크 생성.
  # native build(suffix 없음)인 경우 legacy 경로(wbridge) 사용.
  mkdir -p /usr/local/bin
  if [ "$BOARD_TYPE" = "imx93" ]; then
    WBRIDGE_SUFFIX="_imx93"
  elif [ "$BOARD_TYPE" = "imx8mm" ] || [ "$BOARD_TYPE" = "imx8" ]; then
    WBRIDGE_SUFFIX="_imx8"
  else
    WBRIDGE_SUFFIX=""
  fi
  # 보드별 바이너리가 없으면 suffix 없는 legacy로 폴백
  if [ -n "$WBRIDGE_SUFFIX" ] && [ ! -f "/usr/local/wlan-bridge/wbridge/wbridge${WBRIDGE_SUFFIX}" ]; then
    logger -p local0.warn "[$tag:$LINENO] [$KEY] wbridge${WBRIDGE_SUFFIX} missing, falling back to suffix-less binary"
    WBRIDGE_SUFFIX=""
  fi
  ln -sf "/usr/local/wlan-bridge/wbridge/wbridge${WBRIDGE_SUFFIX}" /usr/local/bin/wifi-wbridge
  ln -sf "/usr/local/wlan-bridge/wbridge/wbridge-tpacket${WBRIDGE_SUFFIX}" /usr/local/bin/wifi-wbridge-tpacket
  ln -sf "/usr/local/wlan-bridge/wbridge/wifi_bridge@.service" /etc/systemd/system/wifi_bridge@.service
  logger -p local0.info "[$tag:$LINENO] [$KEY] wbridge symlinks → suffix='${WBRIDGE_SUFFIX}' (BOARD_TYPE=$BOARD_TYPE)"

  logger -p local0.info "[$tag:$LINENO] [$KEY] Successfully created symlinks for wbridge binaries"

  # Custom wpa_supplicant (dpkg-divert로 원본 보존, 보드별 바이너리 선택)
  if [ "$BOARD_TYPE" = "imx93" ]; then
    WPA_SUFFIX="imx93"
  else
    WPA_SUFFIX="imx8"
  fi
  if [ -f /opt/wlan/bin/wpa_supplicant.${WPA_SUFFIX} ]; then
    dpkg-divert --local --rename --add /usr/sbin/wpa_supplicant 2>/dev/null || true
    dpkg-divert --local --rename --add /usr/sbin/wpa_cli 2>/dev/null || true
    ln -sf /opt/wlan/bin/wpa_supplicant.${WPA_SUFFIX} /usr/sbin/wpa_supplicant
    ln -sf /opt/wlan/bin/wpa_cli.${WPA_SUFFIX} /usr/sbin/wpa_cli
    logger -p local0.info "[$tag:$LINENO] [$KEY] Custom wpa_supplicant.${WPA_SUFFIX} installed via dpkg-divert"
  fi

  # NXP WLAN tools
  ln -sf /opt/wlan/bin/iw /usr/local/bin/iw

  # mlanutl: board-specific binary (imx8/imx93), fallback to legacy single binary
  if [ "$BOARD_TYPE" = "imx93" ]; then
    MLANUTL_SUFFIX="imx93"
  else
    MLANUTL_SUFFIX="imx8"
  fi
  if [ -f /opt/wlan/bin/mlanutl_${MLANUTL_SUFFIX} ]; then
    ln -sf /opt/wlan/bin/mlanutl_${MLANUTL_SUFFIX} /usr/local/bin/mlanutl
    logger -p local0.info "[$tag:$LINENO] [$KEY] Linked mlanutl_${MLANUTL_SUFFIX} -> /usr/local/bin/mlanutl"
  elif [ -f /opt/wlan/bin/mlanutl ]; then
    ln -sf /opt/wlan/bin/mlanutl /usr/local/bin/mlanutl
    logger -p local0.warn "[$tag:$LINENO] [$KEY] mlanutl_${MLANUTL_SUFFIX} not found; fallback to legacy /opt/wlan/bin/mlanutl"
  else
    logger -p local0.err "[$tag:$LINENO] [$KEY] No mlanutl binary found (tried mlanutl_${MLANUTL_SUFFIX} and legacy mlanutl)"
  fi

  ln -sf /opt/wlan/bin/mlan2040coex /usr/local/bin/mlan2040coex
  ln -sf /opt/wlan/bin/mlanconfig /usr/local/bin/mlanconfig
  ln -sf /opt/wlan/bin/mlanevent.exe /usr/local/bin/mlanevent
  rm -rf /usr/local/mfgtool 2>/dev/null || true
  ln -sf /opt/wlan/mfg/mfgbridge /usr/local/mfg/mfgbridge
  ln -sf /usr/local/scripts/wifi.sh /usr/local/bin/wifi
  # /var/log/journal 은 Storage=volatile 에서 journald 가 참조하지 않는다.
  # 과거 설치가 만든 dangling 심볼릭만 정리한다(영속화는 journald 스냅샷이 담당).
  [ -L /var/log/journal ] && rm -f /var/log/journal
  ln -sf /usr/local/scripts/logctl.sh /usr/local/bin/logctl
  ln -sf /usr/local/scripts/mlanutl_silent.sh /usr/local/bin/mlanutl_silent
  ln -sf /usr/local/logger/passive_roam.py /usr/local/bin/roaming
  ln -sf /usr/local/logger/usb_print.py /usr/local/bin/usb_print
  ln -sf /usr/local/logger/print.py /usr/local/bin/print
  ln -sf /usr/local/scripts/wifi_mfg.sh /usr/local/bin/mfg

  /usr/local/logger/print.py green "\r\n[installer] change line..."
  /usr/local/scripts/change_line.sh "#echo 7 > /proc/sys/kernel/printk" "/proc/sys/kernel/printk" /etc/rc.local
  /usr/local/scripts/change_line.sh "kernel.printk = 1 4 1 7" "kernel.printk = " /etc/sysctl.conf
  /usr/local/scripts/change_line.sh "#tmpfs                /var/volatile        tmpfs      defaults              0  0" "tmpfs                /var/volatile" /etc/fstab
  /usr/local/scripts/change_line.sh "WatchdogDevice=/dev/watchdog" "WatchdogDevice=" /etc/systemd/system.conf
  /usr/local/scripts/change_line.sh "DefaultTimeoutStartSec=30s" "DefaultTimeoutStartSec=" /etc/systemd/system.conf
  /usr/local/scripts/change_line.sh "DefaultTimeoutStopSec=30s" "DefaultTimeoutStopSec=" /etc/systemd/system.conf
  /usr/local/scripts/change_line.sh "DefaultTimeoutAbortSec=30s" "DefaultTimeoutAbortSec=" /etc/systemd/system.conf
  /usr/local/scripts/change_line.sh "DefaultDeviceTimeoutSec=30s" "DefaultDeviceTimeoutSec=" /etc/systemd/system.conf
  /usr/local/scripts/add_line.sh "kernel.panic=5" /etc/sysctl.conf
  /usr/local/scripts/add_line.sh "kernel.panic_on_oops=1" /etc/sysctl.conf
  /usr/local/scripts/add_line.sh "watchdog-timeout=30" /etc/watchdog.conf
  /usr/local/scripts/change_line.sh "log-dir=/var/log/cantops" "log-dir" /etc/watchdog.conf
  /usr/local/scripts/change_line.sh "#root" "root" /etc/vsftpd.ftpusers
  /usr/local/scripts/change_line.sh "#root" "root" /etc/vsftpd.user_list
  /usr/local/scripts/add_line.sh "/dev/mmcblk${EMMC_NUM}p3      /var/log/cantops  ext4  noatime,nodiratime,lazytime,commit=60,data=ordered  0  2" /etc/fstab

  # /etc/systemd/system.conf 변경(DefaultTimeout*, WatchdogDevice)은 PID1이 부팅 시
  # 읽으므로 다음 부팅에 적용된다. 설치 도중 daemon-reload로 system.conf를 다시
  # 읽게 하지 않는다(WatchdogDevice 재오픈/타이머 재평가 등 부작용 회피).

  # wifi_thermal_state.timer 의 enable/disable 은 wifi_apply_enabled.sh 가
  # JSON .wbridge.thermal.enabled (SSoT) 기준으로 전담한다. postinst 내 thermal 전용
  # 제어 로직만 제거했으며, 설치 시점엔 위에서 호출한 wifi_apply_enabled.sh 가,
  # 이후 매 부팅엔 wifi_init.service(ExecStartPre) 가 타이머 상태를 동기화한다.

  if command -v sysctl >/dev/null 2>&1; then
    sysctl --system >/dev/null 2>&1 || true
    logger -p local0.info "[$tag:$LINENO] [$KEY] Applied sysctl --system"
  fi

  # VHL daemon
  if [ -f /usr/local/vhl_daemon/vhld.service ]; then
    cp /usr/local/vhl_daemon/vhld.service /etc/systemd/system/
    #systemctl daemon-reload
    #systemctl enable vhld.service
    #systemctl start vhld.service || true
  fi

  PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"
  echo -e "\e[1m installed $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME)\e[0m"
  logger -p local0.info "[$tag:$LINENO] [$KEY] installed $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME)"
  /usr/local/logger/print.py green "\r\n[installer] installed $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME)"
  # backup_file.sh의 self-healing은 .bak이 존재해야 동작한다.
  # 첫 부팅의 사각지대를 없애기 위해 설치 종료 직전 보호 대상의 .bak을 일괄 선제 생성.
  init_protect_baks() {
    local pairs=(
      "/lib/firmware/cts/wifi_mod_para.conf:PCIE9098_0|SD9098_0"
      "/lib/firmware/cts/txpwrlimit_cfg_9098.conf:txpwrlimit_2g_cfg_set"
      "/lib/firmware/cts/txpwrlimit_cfg_9098_low.conf:txpwrlimit_2g_cfg_set"
      "/lib/firmware/cts/txpwrlimit_cfg_9098_org.conf:txpwrlimit_2g_cfg_set"
      "/lib/firmware/cts/txpwrlimit_cfg_9098_a0.conf:txpwrlimit_2g_cfg_set"
      "/etc/systemd/network/20-mlan0.network:mlan0"
      "/etc/systemd/network/21-mlan1.network:mlan1"
      "/etc/systemd/network/22-eth0.network:eth0"
      "/etc/wpa_supplicant/wpa_supplicant-mlan0.conf:network="
      "/etc/wpa_supplicant/wpa_supplicant-mlan1.conf:network="
    )
    local entry f pat
    for entry in "${pairs[@]}"; do
      f="${entry%%:*}"
      pat="${entry#*:}"
      [ -s "$f" ] || continue
      if grep -qE "$pat" "$f" 2>/dev/null; then
        cp "$f" "$f.bak" 2>/dev/null && sync "$f.bak" 2>/dev/null || sync
        logger -p local0.info "[$tag:$LINENO] [$KEY] init .bak: $f.bak"
      else
        logger -p local0.warn "[$tag:$LINENO] [$KEY] init .bak skipped (pattern miss): $f"
      fi
    done
  }
  init_protect_baks

  /usr/local/scripts/fake-hwclock.sh save
  sync
  ;;

upgrade)
  echo "postinst upgrade ($model)"
  ;;

*)
  echo "Unrecognized postinst argument '$1'"

esac
