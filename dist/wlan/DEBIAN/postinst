#!/bin/bash

############################################################
# postinst script main
############################################################
# Include debconf library.
tag=$(basename "$0")
KEY=PKG
PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"
KERNEL_VERSION=$(uname -r)
#hostname=$(python3 /opt/cis/bin/getconfval.py hostname)
hostname=Cantops

INSTALL_DOT_COUNT=0

disable_services_if_enabled() {
    local services=("$@")
    for svc in "${services[@]}"; do
        local svc_clean="${svc%.service}"
        echo "[INFO] Checking service: $svc_clean"

        if command -v systemctl >/dev/null 2>&1; then
            if systemctl is-enabled --quiet "$svc_clean"; then
                echo "[INFO] Disabling $svc_clean (via systemctl)"
                systemctl disable "$svc_clean"
            else
                echo "[INFO] $svc_clean is already disabled"
            fi
        else
            echo "[WARN] systemctl not available, skipping disable for $svc_clean"
        fi
    done
}

case "$1" in
configure)
  echo "postinst configure"

  # CRITICAL: Verify binaries and config exist BEFORE making any system changes
  # This prevents leaving the system in an inconsistent state if installation fails
  if [ ! -f /usr/local/wlan-bridge/dumb/dumb ]; then
    echo "ERROR: /usr/local/wlan-bridge/dumb/dumb not found" >&2
    logger -p local0.err "[$KEY][$tag:$LINENO] Critical: dumb binary not found at /usr/local/wlan-bridge/dumb/dumb"
    exit 1
  fi
  if [ ! -f /usr/local/wlan-bridge/dumb/dumb-tpacket ]; then
    echo "ERROR: /usr/local/wlan-bridge/dumb/dumb-tpacket not found" >&2
    logger -p local0.err "[$KEY][$tag:$LINENO] Critical: dumb-tpacket binary not found at /usr/local/wlan-bridge/dumb/dumb-tpacket"
    exit 1
  fi
  # Ensure config.json exists (used by wifi_init.sh for interface configuration)
  if [ ! -f /usr/local/etc/config.json ]; then
    mkdir -p /usr/local/etc
    cat > /usr/local/etc/config.json << 'CONFIGEOF'
{
    "mlan0": {
        "Frequency": "5GHz",
        "enabled": true
    },
    "mlan1": {
        "Frequency": "2.4GHz",
        "enabled": false
    },
    "eth0": {
        "enabled": true
    }
}
CONFIGEOF
  fi
  # Validate config.json if jq is available
  if command -v jq >/dev/null 2>&1; then
    if ! jq empty /usr/local/etc/config.json 2>/dev/null; then
      echo "ERROR: /usr/local/etc/config.json is invalid JSON" >&2
      logger -p local0.err "[$KEY][$tag:$LINENO] Critical: config.json is invalid JSON"
      exit 1
    fi
  fi
  echo "[INFO] Binary and configuration verification passed"

  cp /opt/wlan/config/logrotate.d/logrotate.rsyslog /etc/logrotate.d/
  cp /opt/wlan/config/rsyslog.conf /etc/
  cp /opt/wlan/config/smb.conf /etc/samba/
  #cp /opt/wlan/config/systemd/timesyncd.conf /etc/systemd/
  cp /opt/wlan/config/wifi_mod_para__.conf /lib/firmware/nxp/
  cp /opt/wlan/config/crontab /etc/
  #cp /opt/wlan/firmware/* /lib/firmware/nxp/
  #cp /opt/wlan/driver/* /lib/modules/$KERNEL_VERSION/updates/
  cp /opt/wlan/config/wpa_supplicant/wpa_supplicant@.service /lib/systemd/system/
  cp /opt/wlan/config/systemd/journald.conf /etc/systemd/
  cp /opt/wlan/config/snmp/snmpd.conf /etc/snmp/

  systemctl restart rsyslog
  systemctl restart systemd-journald

  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
  fi

  #/usr/local/scripts/auto_fs_sizeup.sh 2 2
  # Time safety for systems without NTP
  # Only set time if system clock is before 2020-01-01 (avoids jumping valid clocks)
  SAFE_TIME="2020-01-01 00:00:00"
  CURRENT_TS=$(date +%s)
  SAFE_TS=$(date -d "$SAFE_TIME" +%s 2>/dev/null || echo 1577836800)
  echo "date : $(date '+%Y-%m-%d %H:%M:%S')"

  if [ "$CURRENT_TS" -lt "$SAFE_TS" ]; then
    # System time is before 2020-01-01, set to safe time
    echo "WARNING: System time is before $SAFE_TIME, setting to safe time"
    timedatectl set-ntp false 2>/dev/null || true
    timedatectl set-timezone Asia/Seoul 2>/dev/null || true
    timedatectl set-time "$SAFE_TIME" 2>/dev/null || true
  else
    # Time looks reasonable (after 2026-01-01), just set timezone
    timedatectl set-timezone Asia/Seoul 2>/dev/null || true
  fi

  /usr/local/scripts/auto_fs_sizeup.sh 2 3

:<<'END'
  status=$(df |grep /dev/root |awk '{print $2}')
  if [ "$status" -ge 30000000 ]; then
    echo "disk size : $status over 30000000 byte"
  else
    echo "emmc auto size up"
    /opt/pim/bin/auto_fs_sizeup.sh 2 2
  fi

  status=$(timedatectl |grep NTP|awk '{print $3}')
  if [ "$status" == "inactive" ]; then
    echo "ntp is $status"
  else
    echo "set-ntp false"
    timedatectl set-ntp false
  fi

  status=$(timedatectl |grep Time|awk '{print $3}')
  if [ "$status" == "Asia/Seoul" ]; then
    echo "timezone is $status"
  else
    echo "set-timezone Asis/Seoul"
    timedatectl set-timezone Asia/Seoul
  fi

  #timedatectl set-timezone Etc/UTC
END
  #timedatectl set-timezone Asia/Seoul

set_timezone() {
  local target_tz="$1"
  if [ -z "$target_tz" ]; then
    echo "Usage: set_timezone <TimeZone>"
    return 1
  fi

  current_tz=$(timedatectl | grep 'Time zone' | awk '{print $3}')
  if [ "$current_tz" == "$target_tz" ]; then
    echo "Timezone is already set to $current_tz"
  else
    echo "Changing timezone from $current_tz to $target_tz"
    timedatectl set-timezone "$target_tz"
  fi
}

  #set_timezone Japan

customctl() {
    target=$1
    daemon_name=$2

    status=$(systemctl is-enabled $daemon_name 2>/dev/null)

    if [[ $status != ${target}* ]]; then
        if [[ $target = enable* ]]; then
            systemctl enable $daemon_name
        elif [[ $target = disable* ]]; then
            if [[ $status != mask* ]]; then
                systemctl disable --now $daemon_name
            fi
        elif [[ $target = mask* ]]; then
            systemctl disable --now $daemon_name
            systemctl mask $daemon_name
        else
            echo "$target is wrong status"
            return 1
        fi
    fi

    status=$(systemctl is-enabled $daemon_name 2>/dev/null)
    echo "$daemon_name is $status"
    INSTALL_DOT_COUNT=$((INSTALL_DOT_COUNT + 1))
    dots=$(printf "%${INSTALL_DOT_COUNT}s" | tr ' ' '.')
    /usr/local/logger/print.py green "\r\n[installer] installing${dots}"
}
  mv /etc/init.d/samba /etc/init.d/samba.disabled

  customctl mask systemd-networkd-wait-online
  customctl mask nfs-server
  customctl mask proc-fs-nfsd.mount
  customctl mask ovsdb-server
  customctl mask avahi-daemon
  customctl mask avahi-autoipd
  customctl mask psplash
  customctl disable dhcpcd
  customctl disable psplash-quit
  customctl disable weston
  customctl disable openvswitch
  customctl disable openvswitch-switch
  customctl disable connman
  customctl disable smb
  customctl disable nmb
  customctl disable avahi-daemon.socket
  customctl disable containerd
  customctl disable lighttpd
  customctl disable nginx
  customctl disable monkey
  customctl disable netdata
  customctl disable collectd
  customctl disable thttpd
  customctl disable named
  customctl disable bind
  customctl disable fake-hwclock.timer
  customctl disable journald-snapshot.timer
  customctl disable ifplugd
  customctl disable systemd-resolved
  customctl disable hiawatha
  customctl disable netserver
  #customctl disable samba
  #customctl disable hciattach

  customctl enable watchdog
  customctl enable switchd enabled
  customctl enable fake-hwclock
  customctl enable wifi_init
  customctl enable wifi_logger

  customctl disable wifi_checker@eth0
  customctl enable wifi_led@eth0
  customctl enable wifi_logger@eth0

  customctl enable wifi_led@mlan0
  customctl enable wifi_logger@mlan0
  customctl enable wifi_checker@mlan0
  customctl enable wifi_bgscan@mlan0
  customctl enable wifi_roam@mlan0
  customctl enable wifi_arping@mlan0
  #customctl enable wifi_capture@mlan0

  #customctl wifi_logger@mlan1 disabled
  #customctl wifi_checker@mlan1 disabled
  #customctl wifi_ping@mlan1 disabled
  #customctl wifi_arp@mlan1 disabled
  #customctl wifi_arping@mlan1 disabled

  #customctl wpa_supplicant@mlan0 enabled
  #customctl wifi_bridge@mlan0 enabled

makeDirectory() {
    if [ ! -d "$1" ]; then
        echo "Creating $1 directory..."
        mkdir -p "$1"
        if [ $? -eq 0 ]; then
            echo "Directory $1 created successfully."
        else
            #echo "Failed to create $1 directory."
            logger -s -p local0.err "Failed to create $1 directory."
            exit 1
        fi
    else
        echo "$1 directory already exists."
    fi
}
  makeDirectory /etc/wpa_supplicant
  makeDirectory /opt/wlan/mac
  makeDirectory /usr/local/mfg
  makeDirectory /usr/local/bin
  makeDirectory /usr/local/logger
  makeDirectory /usr/local/scripts

  touch /opt/wlan/mac/base0
  touch /opt/wlan/mac/base1
  touch /opt/wlan/mac/target0
  touch /opt/wlan/mac/target1
  touch /opt/wlan/mac/wired
  touch /opt/wlan/mac/wired_client

  #makeDirectory /var/log/cantops/journal
  #echo "update dtb"
  #makeDirectory /root/boot
  #mount /dev/mmcblk2p1 /root/boot
  #cp /opt/pim/boot/imx8mp*.dtb /root/boot/
  #umount /root/boot

  #echo "set id, passwd"
  #(echo root; echo root;) | passwd root
  #(echo user; echo user;) | smbpasswd -as user
  #(echo root; echo root;) | smbpasswd -as root
  #useradd -m semes && (echo semes; echo semes;) | passwd semes

#  chmod -R 777 /mnt/sd_cam
#  chmod 777 /share
#  chmod 777 /shared
#  echo "set sshd"
#  sed 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' -i /etc/ssh/sshd_config

  #echo "set printk"
  #sed '/kernel.printk/ c\kernel.printk = 2 4 1 3' -i /etc/sysctl.conf

  echo "set hostname"
  echo $hostname > /etc/hostname
  sed -i "2s/.*/127.0.1.1 $hostname/g" -i /etc/hosts
#  sed -i 's/#kernel.printk = 3 4 1 3/kernel.printk = 2 4 1 3/g' -i /etc/sysctl.conf

  INSTALL_DOT_COUNT=$((INSTALL_DOT_COUNT + 1))
  dots=$(printf "%${INSTALL_DOT_COUNT}s" | tr ' ' '.')
  /usr/local/logger/print.py green "\r\n[installer] installing${dots}"

  #/usr/local/scripts/add_line.sh "00 *      * * *    root        logrotate /etc/logrotate.d/logrotate.rsyslog" /etc/crontab
  #/usr/local/scripts/comment_line.sh "tmpfs                /var/volatile" /etc/fstab
  #/usr/local/scripts/change_line.sh "echo 1 > /proc/sys/kernel/printk" "/proc/sys/kernel/printk" /etc/rc.local
  /usr/local/scripts/change_line.sh "kernel.printk = 1 4 1 7" "kernel.printk = " /etc/sysctl.conf
  /usr/local/scripts/change_line.sh "#tmpfs                /var/volatile        tmpfs      defaults              0  0" "tmpfs                /var/volatile" /etc/fstab
  /usr/local/scripts/change_line.sh "WatchdogDevice=/dev/watchdog" "WatchdogDevice=" /etc/systemd/system.conf
  /usr/local/scripts/change_line.sh "DefaultTimeoutStartSec=30s" "DefaultTimeoutStartSec=" /etc/systemd/system.conf
  /usr/local/scripts/change_line.sh "DefaultTimeoutStopSec=30s" "DefaultTimeoutStopSec=" /etc/systemd/system.conf
  /usr/local/scripts/change_line.sh "DefaultTimeoutAbortSec=30s" "DefaultTimeoutAbortSec=" /etc/systemd/system.conf
  /usr/local/scripts/change_line.sh "DefaultDeviceTimeoutSec=30s" "DefaultDeviceTimeoutSec=" /etc/systemd/system.conf
  /usr/local/scripts/add_line.sh "kernel.panic=5" /etc/sysctl.conf
  /usr/local/scripts/add_line.sh "kernel.panic_on_oops=1" /etc/sysctl.conf
  /usr/local/scripts/add_line.sh "watchdog-timeout=30" /etc/watchdog.conf
  /usr/local/scripts/change_line.sh "log-dir=/var/log/cantops" "log-dir" /etc/watchdog.conf
  /usr/local/scripts/change_line.sh "#root" "root" /etc/vsftpd.ftpusers
  /usr/local/scripts/change_line.sh "#root" "root" /etc/vsftpd.user_list
  /usr/local/scripts/add_line.sh "/dev/mmcblk2p3      /var/log/cantops  ext4  noatime,nodiratime,lazytime,commit=60,data=ordered  0  2" /etc/fstab

cpchk() {
  if [ ! -f $2 ]; then
    logger -s -p local0.info "[$KEY][$tag:$LINENO] cp $1 $2"
    cp $1 $2
  fi
}
  #if [ ! -f /lib/firmware/nxp/wifi_mod_para__.conf ]; then
  #  logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /lib/firmware/nxp/wifi_mod_para__.conf"
  #  cp /opt/wlan/config/wifi_mod_para__.conf /lib/firmware/nxp/wifi_mod_para__.conf
  #fi

  cpchk /opt/wlan/mfg/bridge_init.conf /usr/local/mfg/bridge_init.conf
  cpchk /opt/wlan/config/systemd/timesyncd.conf /etc/systemd/timesyncd.conf
  cpchk /opt/wlan/config/wpa_supplicant/wpa_supplicant-mlan0.conf /etc/wpa_supplicant/wpa_supplicant-mlan0.conf
  cpchk /opt/wlan/config/wpa_supplicant/wpa_supplicant-mlan1.conf /etc/wpa_supplicant/wpa_supplicant-mlan1.conf
  cpchk /opt/wlan/config/systemd/network/20-mlan0.network /etc/systemd/network/20-mlan0.network
  cpchk /opt/wlan/config/systemd/network/21-mlan1.network /etc/systemd/network/21-mlan1.network
  cpchk /opt/wlan/config/systemd/network/22-eth0.network /etc/systemd/network/22-eth0.network
  cpchk /opt/wlan/config/systemd/network/10-lo.network /etc/systemd/network/10-lo.network
  cpchk /opt/wlan/config/systemd/network/20-mlan0.link /etc/systemd/network/20-mlan0.link
  cpchk /opt/wlan/config/systemd/network/21-mlan1.link /etc/systemd/network/21-mlan1.link
  cpchk /opt/wlan/config/systemd/network/22-eth0.link /etc/systemd/network/22-eth0.link

  INSTALL_DOT_COUNT=$((INSTALL_DOT_COUNT + 1))
  dots=$(printf "%${INSTALL_DOT_COUNT}s" | tr ' ' '.')
  /usr/local/logger/print.py green "\r\n[installer] installing${dots}"

  # Create symlinks for wlan-bridge binaries
  # Ensure target directory exists
  mkdir -p /usr/local/bin

  # ln -sf automatically overwrites existing files/symlinks
  ln -sf /usr/local/wlan-bridge/dumb/dumb /usr/local/bin/wifi-dumb
  ln -sf /usr/local/wlan-bridge/dumb/dumb-tpacket /usr/local/bin/wifi-dumb-tpacket
  # Legacy compatibility: link dumb directly to actual binary (no chain)
  ln -sf /usr/local/wlan-bridge/dumb/dumb /usr/local/bin/dumb
  ln -sf /usr/local/wlan-bridge/dumb/dumb-tpacket /usr/local/bin/dumb-tpacket

  logger -p local0.info "[$KEY][$tag:$LINENO] Successfully created symlinks for wlan-bridge binaries"

  # NXP WLAN tools
  ln -sf /opt/wlan/bin/iw /usr/local/bin/iw
  ln -sf /opt/wlan/bin/mlanutl /usr/local/bin/mlanutl
  ln -sf /opt/wlan/bin/mlan2040coex /usr/local/bin/mlan2040coex
  ln -sf /opt/wlan/bin/mlanconfig /usr/local/bin/mlanconfig
  ln -sf /opt/wlan/bin/mlanevent.exe /usr/local/bin/mlanevent

  rm -rf /usr/local/mfgtool 2>/dev/null || true
  ln -sf /opt/wlan/mfg/mfgbridge /usr/local/mfg/mfgbridge

  # Utility symlinks
  ln -sf /usr/local/scripts/wifi.sh /usr/local/bin/wifi
  ln -sf /var/log/cantops/journal /var/log/journal 2>/dev/null || true
  ln -sf /usr/local/scripts/logctl.sh /usr/local/bin/logctl
  ln -sf /usr/local/scripts/mlanutl_silent.sh /usr/local/bin/mlanutl_silent
  ln -sf /usr/local/logger/passive_roam.py /usr/local/bin/roaming
  ln -sf /usr/local/logger/usb_print.py /usr/local/bin/usb_print
  ln -sf /usr/local/logger/print.py /usr/local/bin/print
  ln -sf /usr/local/scripts/wifi_mfg.sh /usr/local/bin/mfg

  #tar -xvf /opt/wlan/webmin/webmin_usr.tar -C /usr/libexec/
  #tar -xvf /opt/wlan/webmin/webmin_etc.tar -C /etc/

  PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"
  echo -e "\e[1m installed $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME)\e[0m"
  #echo -e "\e[32m installed $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME) : finish\e[0m" > /dev/ttyGS0
  logger -p local0.info "[$KEY][$tag:$LINENO] installed $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME)"
