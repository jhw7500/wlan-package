#!/bin/bash

############################################################
# postinst script main
############################################################
# Include debconf library.
tag=$(basename "$0")
KEY=PKG
PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"
KERNEL_VERSION=$(uname -r)
#hostname=$(python3 /opt/cis/bin/getconfval.py hostname)
hostname=Cantops

case "$1" in
configure)
  echo "postinst configure"
  /usr/local/scripts/auto_fs_sizeup.sh 2 2

:<<'END'
  status=$(df |grep /dev/root |awk '{print $2}')
  if [ "$status" -ge 30000000 ]; then
    echo "disk size : $status over 30000000 byte"
  else
    echo "emmc auto size up"
    /opt/pim/bin/auto_fs_sizeup.sh 2 2
  fi

  status=$(timedatectl |grep NTP|awk '{print $3}')
  if [ "$status" == "inactive" ]; then
    echo "ntp is $status"
  else
    echo "set-ntp false"
    timedatectl set-ntp false
  fi

  status=$(timedatectl |grep Time|awk '{print $3}')
  if [ "$status" == "Asia/Seoul" ]; then
    echo "timezone is $status"
  else
    echo "set-timezone Asis/Seoul"
    timedatectl set-timezone Asia/Seoul
  fi

  #timedatectl set-timezone Etc/UTC
END
  #timedatectl set-timezone Asia/Seoul

set_timezone() {
  local target_tz="$1"
  if [ -z "$target_tz" ]; then
    echo "Usage: set_timezone <TimeZone>"
    return 1
  fi

  current_tz=$(timedatectl | grep 'Time zone' | awk '{print $3}')
  if [ "$current_tz" == "$target_tz" ]; then
    echo "Timezone is already set to $current_tz"
  else
    echo "Changing timezone from $current_tz to $target_tz"
    timedatectl set-timezone "$target_tz"
  fi
}

  set_timezone Japan

customctl() {
    daemon_name=$1
    target=$2

    status=$(systemctl is-enabled $daemon_name 2>/dev/null)

    if [ "$status" != "$target" ]; then
        if [ "$target" = "enabled" ]; then
            systemctl enable $daemon_name
        elif [ "$target" = "disabled" ]; then
            systemctl disable $daemon_name
        elif [ "$target" = "masked" ]; then
            systemctl disable $daemon_name
            systemctl mask $daemon_name
        else
            echo "$target is wrong status"
            return 1
        fi
    fi

    status=$(systemctl is-enabled $daemon_name 2>/dev/null)
    echo "$daemon_name is $status"
}
  mv /etc/init.d/samba /etc/init.d/samba.disabled

  customctl systemd-networkd-wait-online masked
  customctl dhcpcd disabled
  customctl psplash-quit disabled
  customctl weston disabled
  customctl nfs-server masked
  customctl proc-fs-nfsd.mount masked
  customctl watchdog enabled
  customctl openvswitch disabled
  customctl openvswitch-switch disabled
  customctl connman disabled
  customctl ovsdb-server masked
  customctl smb disabled
  customctl nmb disabled
  customctl avahi-daemon.socket disabled
  customctl avahi-daemon disabled
  customctl containerd disabled
  customctl wifi_capture disabled
  #customctl samba disabled
  #customctl hciattach disabled

  customctl wifi_init enabled
  customctl wifi_logger enabled

  customctl wifi_arping@eth0 enabled
  customctl wifi_logger@eth0 enabled

  customctl wifi_arp@mlan0 disabled
  customctl wifi_arping@mlan0 disabled

  customctl wifi_logger@mlan0 enabled
  customctl wifi_checker@mlan0 enabled
