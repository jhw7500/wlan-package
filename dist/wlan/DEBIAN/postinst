makeDirectory() {
    if [ ! -d "$1" ]; then
        echo "Creating $1 directory..."
        mkdir -p "$1"
        if [ $? -eq 0 ]; then
            echo "Directory $1 created successfully."
        else
            #echo "Failed to create $1 directory."
            logger -s -p local0.err "Failed to create $1 directory."
            exit 1
        fi
    else
        echo "$1 directory already exists."
    fi
}
