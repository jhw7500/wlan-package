#!/bin/bash

############################################################
# postinst script main
############################################################
# Include debconf library.
tag=$(basename "$0")
KEY=PKG
PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"
KERNEL_VERSION=$(uname -r)
#hostname=$(python3 /opt/cis/bin/getconfval.py hostname)
hostname=Cantops

case "$1" in
configure)
  echo "postinst configure"
  /usr/local/scripts/auto_fs_sizeup.sh 2 2

:<<'END'
  status=$(df |grep /dev/root |awk '{print $2}')
  if [ "$status" -ge 30000000 ]; then
    echo "disk size : $status over 30000000 byte"
  else
    echo "emmc auto size up"
    /opt/pim/bin/auto_fs_sizeup.sh 2 2
  fi

  status=$(timedatectl |grep NTP|awk '{print $3}')
  if [ "$status" == "inactive" ]; then
    echo "ntp is $status"
  else
    echo "set-ntp false"
    timedatectl set-ntp false
  fi

  status=$(timedatectl |grep Time|awk '{print $3}')
  if [ "$status" == "Asia/Seoul" ]; then
    echo "timezone is $status"
  else
    echo "set-timezone Asis/Seoul"
    timedatectl set-timezone Asia/Seoul
  fi

  #timedatectl set-timezone Etc/UTC
END
  timedatectl set-timezone Asia/Seoul

customctl() {
    daemon_name=$1
    target=$2

    status=$(systemctl is-enabled $daemon_name 2>/dev/null)

    if [ "$status" != "$target" ]; then
        if [ "$target" = "enabled" ]; then
            systemctl enable $daemon_name
        elif [ "$target" = "disabled" ]; then
            systemctl disable $daemon_name
        elif [ "$target" = "masked" ]; then
            systemctl disable $daemon_name
            systemctl mask $daemon_name
        else
            echo "$target is wrong status"
            return 1
        fi
    fi

    status=$(systemctl is-enabled $daemon_name 2>/dev/null)
    echo "$daemon_name is $status"
}

  customctl systemd-networkd-wait-online masked
  customctl dhcpcd disabled
  customctl psplash-quit disabled
  customctl weston disabled
  customctl nfs-server masked
  customctl proc-nfs-fs-nfsd.mount
  customctl watchdog enabled

  #customctl hciattach disabled
  customctl wifi_init enabled
  customctl wifi_logger enabled
  customctl wifi_logger@mlan0 enabled
  customctl wifi_logger@mlan1 disabled
  customctl wifi_checker@mlan0 enabled
  customctl wifi_checker@mlan1 disabled
  customctl wifi_ping@mlan0 enabled


makeDirectory() {
    if [ ! -d "$1" ]; then
        echo "Creating $1 directory..."
        mkdir -p "$1"
        if [ $? -eq 0 ]; then
            echo "Directory $1 created successfully."
        else
            #echo "Failed to create $1 directory."
            logger -s -p local0.err "Failed to create $1 directory."
            exit 1
        fi
    else
        echo "$1 directory already exists."
    fi
}
  makeDirectory /var/log/cantops/journal
  #echo "update dtb"
  #makeDirectory /root/boot
  #mount /dev/mmcblk2p1 /root/boot
  #cp /opt/pim/boot/imx8mp*.dtb /root/boot/
  #umount /root/boot

  #echo "set id, passwd"
  #(echo root; echo root;) | passwd root
  #(echo user; echo user;) | smbpasswd -as user
  #(echo root; echo root;) | smbpasswd -as root
  #useradd -m semes && (echo semes; echo semes;) | passwd semes

#  chmod -R 777 /mnt/sd_cam
#  chmod 777 /share
#  chmod 777 /shared
#  echo "set sshd"
#  sed 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' -i /etc/ssh/sshd_config

  echo "set printk"
  sed '/kernel.printk/ c\kernel.printk = 2 4 1 3' -i /etc/sysctl.conf

  echo "set hostname"
  echo $hostname > /etc/hostname
  sed -i "2s/.*/127.0.1.1 $hostname/g" -i /etc/hosts
#  sed -i 's/#kernel.printk = 3 4 1 3/kernel.printk = 2 4 1 3/g' -i /etc/sysctl.conf

  #/usr/local/scripts/add_line.sh "00 *      * * *    root        logrotate /etc/logrotate.d/logrotate.rsyslog" /etc/crontab
  #/usr/local/scripts/comment_line.sh "tmpfs                /var/volatile" /etc/fstab
  /usr/local/scripts/change_line.sh "#tmpfs                /var/volatile        tmpfs      defaults              0  0" "tmpfs                /var/volatile" /etc/fstab
  /usr/local/scripts/change_line.sh "ExecStart=/usr/sbin/wpa_supplicant -c/etc/wpa_supplicant/wpa_supplicant-%I.conf -i%I -d" "ExecStart=/usr/sbin/wpa_supplicant" /lib/systemd/system/wpa_supplicant@.service
  /usr/local/scripts/change_line.sh "Storage=persistent" "Storage=" /etc/systemd/journald.conf
  /usr/local/scripts/add_line.sh "kernel.panic=5" /etc/sysctl.conf
  /usr/local/scripts/add_line.sh "kernel.panic_on_oops=1" /etc/sysctl.conf
  /usr/local/scripts/add_line.sh "SystemMaxUse=2000M" /etc/systemd/journald.conf
  /usr/local/scripts/add_line.sh "SystemKeepFree=500M" /etc/systemd/journald.conf
  /usr/local/scripts/add_line.sh "watchdog-timeout=15" /etc/watchdog.conf

  cp /opt/wlan/config/logrotate.d/logrotate.rsyslog /etc/logrotate.d/
  #cp /opt/wlan/config/rc.local /etc/
  cp /opt/wlan/config/rsyslog.conf /etc/
  cp /opt/wlan/config/smb.conf /etc/samba/
  
  mkdir -p /etc/wpa_supplicant

  if [ ! -f /etc/wpa_supplicant/wpa_supplicant-mlan0.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/wpa_supplicant/wpa_supplicant-mlan0.conf"
    cp /opt/wlan/config/wpa_supplicant/wpa_supplicant-mlan0.conf /etc/wpa_supplicant/wpa_supplicant-mlan0.conf
  fi

  if [ ! -f /etc/wpa_supplicant/wpa_supplicant-mlan1.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/wpa_supplicant/wpa_supplicant-mlan1.conf"
    cp /opt/wlan/config/wpa_supplicant/wpa_supplicant-mlan1.conf /etc/wpa_supplicant/wpa_supplicant-mlan1.conf
  fi

  if [ ! -f /etc/systemd/network/20-mlan0.network ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/systemd/network/20-mlan0.network"
    cp /opt/wlan/config/network/20-mlan0.network /etc/systemd/network/
  fi

  if [ ! -f /etc/systemd/network/21-mlan1.network ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/systemd/network/21-mlan1.network"
    cp /opt/wlan/config/network/21-mlan1.network /etc/systemd/network/
  fi

  if [ ! -f /etc/systemd/network/22-eth0.network ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/systemd/network/22-eth0.network"
    cp /opt/wlan/config/network/22-eth0.network /etc/systemd/network/
  fi


  #mv /usr/local/bin/iw /usr/local/bin/iw_org
  #ln -s /usr/local/bin/iw_new /usr/local/bin/iw
  ln -s /usr/local/scripts/wifi.sh /usr/local/bin/wifi
  ln -s /var/log/cantops/journal /var/log/journal
  ln -s /usr/local/scripts/logctl.sh /usr/local/bin/logctl

  PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"
  echo -e "\e[32m install $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME) finish\e[0m"
  logger -p local0.notice "[$KEY][$tag:$LINENO] install $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME) finish"
  sync
  ;;

upgrade)
  echo "postinst upgrade ($model)"
  ;;

*)
  echo "Unrecognized postinst argument '$1'"

esac
