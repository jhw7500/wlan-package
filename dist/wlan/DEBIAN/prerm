#!/bin/bash

############################################################
# prerm script - executed before package removal
############################################################

tag=$(basename "$0")
KEY=PKG

stop_service_if_active() {
    local svc="$1"
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        echo "[INFO] Stopping $svc..."
        systemctl stop "$svc" 2>/dev/null || true
    fi
}

disable_service_if_enabled() {
    local svc="$1"
    if systemctl is-enabled --quiet "$svc" 2>/dev/null; then
        echo "[INFO] Disabling $svc..."
        systemctl disable "$svc" 2>/dev/null || true
    fi
}

case "$1" in
upgrade)
    echo "prerm upgrade"
    # Stop services before upgrade
    stop_service_if_active wifi_bridge@mlan0
    stop_service_if_active wifi_bridge@mlan1
    for _iface in mlan0 mlan1; do
        stop_service_if_active "wifi_raw_commit@${_iface}.path"
        stop_service_if_active "wifi_raw_commit@${_iface}.service"
    done
    ;;

remove|deconfigure)
    echo "prerm remove"
    logger -p local0.info "[$tag:$LINENO] [$KEY] Removing wlan-proc package"

    # Stop all wlan services
    # wifi-stack.target 을 먼저 stop 하면 PartOf=wifi_init.service 로 묶인 자식 유닛이
    # 자동 stop 된다. 개별 stop 은 누락 방지용 안전망.
    echo "[INFO] Stopping WLAN services..."
    stop_service_if_active wifi-stack.target
    stop_service_if_active wifi_init
    stop_service_if_active wifi_apply_enabled
    stop_service_if_active wlan_emergency_reboot.service
    for _iface in mlan0 mlan1; do
        stop_service_if_active "wifi_raw_commit@${_iface}.path"
        stop_service_if_active "wifi_raw_commit@${_iface}.service"
        for _u in wifi_bridge wifi_checker wifi_logger wifi_led wifi_roam \
                  wifi_bgscan wifi_arping wifi_event wifi_periodic_roam \
                  wifi_capture wifi_ping wpa_supplicant; do
            stop_service_if_active "${_u}@${_iface}"
        done
    done
    stop_service_if_active wifi_logger@eth0
    stop_service_if_active wifi_led@eth0
    stop_service_if_active wifi_logger
    stop_service_if_active wifi_ping_monitor
    stop_service_if_active wifi_mgmt_log.timer
    stop_service_if_active wifi_thermal_state.timer
    stop_service_if_active wifi_thermal_state
    stop_service_if_active switchd
    stop_service_if_active opcd
    stop_service_if_active opcd-essid-restore
    stop_service_if_active snmpd
    stop_service_if_active systemd-timesyncd

    # Disable services
    echo "[INFO] Disabling WLAN services..."
    disable_service_if_enabled wifi-stack.target
    disable_service_if_enabled wifi_init
    disable_service_if_enabled wifi_apply_enabled
    # ACL oneshot 비활성 + 남은 nft 룰 제거(제거 후 고아 방화벽 룰 방지, Codex)
    disable_service_if_enabled wifi_acl
    [ -x /usr/local/scripts/wifi_acl.sh ] && /usr/local/scripts/wifi_acl.sh clear 2>/dev/null || true
    disable_service_if_enabled wlan_emergency_reboot.service
    for _iface in mlan0 mlan1; do
        disable_service_if_enabled "wifi_raw_commit@${_iface}.path"
        for _u in wifi_bridge wifi_checker wifi_logger wifi_led wifi_roam \
                  wifi_bgscan wifi_arping wifi_event wifi_periodic_roam \
                  wifi_capture wifi_ping wpa_supplicant; do
            disable_service_if_enabled "${_u}@${_iface}"
        done
    done
    disable_service_if_enabled wifi_logger@eth0
    disable_service_if_enabled wifi_led@eth0
    disable_service_if_enabled wifi_logger
    disable_service_if_enabled wifi_ping_monitor
    disable_service_if_enabled wifi_mgmt_log.timer
    disable_service_if_enabled wifi_thermal_state.timer
    disable_service_if_enabled wifi_thermal_state
    disable_service_if_enabled switchd
    disable_service_if_enabled opcd
    disable_service_if_enabled opcd-essid-restore
    # snmpd: postinst 가 .snmp.enabled=true 일 때 enable 하므로 제거 시 원복(고아 enable + 161 노출 방지).
    disable_service_if_enabled snmpd
    # systemd-timesyncd: .global.ntp.enabled(기본 true)로 이 패키지가 enable 한 배포판 유닛 — 정책
    # 소유자(JSON·wifi_apply_enabled.sh)가 사라지므로 이미지 기본(disabled)으로 원복한다(#361).
    disable_service_if_enabled systemd-timesyncd

    # Reload systemd daemon
    systemctl daemon-reload 2>/dev/null || true
    ;;

*)
    echo "Unrecognized prerm argument '$1'"
    ;;
esac

exit 0
