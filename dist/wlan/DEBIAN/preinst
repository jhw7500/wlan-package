#!/bin/bash

############################################################
# preinst script main
############################################################
# Include debconf library.

PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"
tag=$(basename "$0")
KEY=PKG

echo "install $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME)"
logger -s -p local0.notice "[$KEY][$tag:$LINENO] install $PACKAGE_NAME-$(dpkg-query -W -f='${Version}' $PACKAGE_NAME) start"

stop_services_if_running() {
    local services=("$@")
    for svc in "${services[@]}"; do
        local svc_clean="${svc%.service}"
        echo "[INFO] Checking service: $svc_clean"

        if command -v systemctl >/dev/null 2>&1; then
            if systemctl is-active --quiet "$svc_clean"; then
                echo "[INFO] Stopping $svc_clean (via systemctl)"
                systemctl stop "$svc_clean"
            else
                echo "[INFO] $svc_clean is not active"
            fi
        elif command -v pidof >/dev/null 2>&1; then
            if pidof "$svc_clean" >/dev/null; then
                echo "[INFO] Killing $svc_clean (via pidof)"
                killall "$svc_clean"
            else
                echo "[INFO] $svc_clean not running"
            fi
        else
            # Fallback to ps
            if ps aux | grep -v grep | grep -q "$svc_clean"; then
                echo "[INFO] Killing $svc_clean (via ps)"
                pkill "$svc_clean"
            else
                echo "[INFO] $svc_clean not running"
            fi
        fi
    done
}
case "$1" in
install)
  echo "preinst install ($model)"
  stop_services_if_running \ 
  		wifi_logger@mlan0 \
  		wifi_logger@mlan1 \
  		wifi_logger@eth0 \
  		wifi_checker@mlan0 \
  		wifi_checker@mlan1 \
  		wifi_capture@mlan0 \
  		wifi_capture@mlan1 \
  		wifi_roam@mlan0 \
  		wifi_roam@mlan1 \
  		wifi_bgscan@mlan0 \
  		wifi_bgscan@mlan1 \
  		wifi_arping@eth0 \
  		wifi_arping@mlan0 \
  		wifi_arping@mlan1 \
  		wifi_ping@eth0 \
  		wifi_ping@mlan0 \
  		wifi_ping@mlan1 \
        wifi_bridge@mlan0 \
        wifi_bridge@mlan1

  #killall apt apt-get
  #rm /var/lib/apt/lists/lock
  #rm /var/cache/apt/archives/lock
  #rm /var/lib/dpkg/lock*
  #dpkg --configure -a
  #dpkg --purge pim
  #dpkg --purge pim-test
#  systemctl stop rsyslog
#  git config --global user.name "hwjo" && git config --global user.email "hwjo@cantops.biz"
#  /root/SOMBASE_TEST/mfg60n-aarch64-9.32.0.6.sh install
#  lmu -reg FCC
#  iw set US
  ;;

upgrade)
  echo "preinst upgrade ($model)"
  stop_services_if_running \
                wifi_logger@mlan0 \
                wifi_logger@mlan1 \
                wifi_logger@eth0 \
                wifi_checker@mlan0 \
                wifi_checker@mlan1 \
                wifi_capture@mlan0 \
                wifi_capture@mlan1 \
                wifi_roam@mlan0 \
                wifi_roam@mlan1 \
                wifi_bgscan@mlan0 \
                wifi_bgscan@mlan1 \
                wifi_arping@eth0 \
                wifi_arping@mlan0 \
                wifi_arping@mlan1 \
                wifi_ping@eth0 \
                wifi_ping@mlan0 \
                wifi_ping@mlan1 \
                wifi_bridge@mlan0 \
                wifi_bridge@mlan1

#  systemctl stop rsyslog
  ;;

*)
  echo "Unrecognized preinst argument '$1'"

esac
