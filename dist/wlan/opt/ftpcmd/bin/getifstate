#!/bin/sh
# Report a network interface's state.  Reached over FTP as: quote getifstate [interface]
#
# With no argument it acts on mlan0.
#
# Reply shape is a compatibility contract, not a style choice.  The card this
# board replaces (FXE3000) answers exactly
#     200 ath0 UP
#     200 ath0 DOWN
# and the upper tool parses that single line, so emit one line of the same
# shape and nothing else.
#
# UP/DOWN is the *administrative* flag (IFF_UP in /sys/class/net/<if>/flags),
# which is what ifcup/ifcdown toggle -- the reference transcript reports UP
# immediately after IFCUP.  operstate is deliberately not used: it lags
# association on wireless and reads "unknown" on interfaces that never set it
# (measured on target: lo has operstate=unknown while IFF_UP=1).
#
# Run by vsftpd's privileged parent, as root, with cwd / and a fixed PATH.
# vsftpd already restricts arguments to a narrow character set, but the check
# below is what actually decides which interfaces may be queried, so keep it.
#
# Contract: the dispatch rules this relies on -- argv, the environment
# vsftpd exports, the private PID namespace, and the exit-status-to-reply-
# code mapping -- are defined by 0001-vsftpd-external-command-dispatch.patch
# in the meta-cts-wlan layer (recipes-daemons/vsftpd/vsftpd/).  Read that
# patch header before changing anything here.
set -u

IFACE="${1:-mlan0}"

case "$IFACE" in
    *[!A-Za-z0-9._-]*)  echo "invalid interface name: $IFACE"; exit 2 ;;
esac

if [ ! -e "/sys/class/net/$IFACE" ]; then
    echo "no such interface: $IFACE"
    exit 2
fi

FLAGS=$(cat "/sys/class/net/$IFACE/flags" 2>/dev/null) || FLAGS=""
case "$FLAGS" in
    0x*) ;;
    *)   echo "cannot read state of $IFACE"; exit 1 ;;
esac

# IFF_UP is bit 0.  The file is 0x-prefixed hex; POSIX arithmetic accepts it.
if [ $(( FLAGS & 1 )) -eq 1 ]; then
    echo "$IFACE UP"
else
    echo "$IFACE DOWN"
fi
exit 0
