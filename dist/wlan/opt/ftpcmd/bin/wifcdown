#!/bin/sh
# Bring down a required station interface, preserving FTP connection protection.
#   quote wifcdown <mlan0|mlan1|0|1>
set -u

/usr/bin/python3 "$(dirname "$0")/../lib/ftpcmd_log.py" wifcdown >/dev/null 2>&1 || true

if [ "$#" -ne 1 ]; then
    echo "usage: wifcdown <mlan0|mlan1|0|1>"
    exit 2
fi
case "$1" in
    mlan0|0) IFACE=mlan0 ;;
    mlan1|1) IFACE=mlan1 ;;
    *) echo "invalid interface: $1"; exit 2 ;;
esac

export FTPCMD_START_LOGGED_FOR=ifcdown
exec "$(dirname "$0")/ifcdown" "$IFACE"
