#!/usr/bin/python3
"""Save, read and apply the device settings file /home/admin/wconfig.txt (#464).

Reached over FTP as: quote wconfig get [KEY] | put KEY=VALUE [WORD...] | apply

The file is KEY=VALUE text using the key names of the CONTEC settings export.
apply validates every line first and changes nothing when one is wrong.  It then
saves each store and hands PID 1 a single systemctl --no-block action per
service, so the handler ends well inside the dispatcher's 30 s limit; a detached
child would be killed with the FTP session (see rst).  SNMP_COMMUNITY and
SNMP_SYS* rewrite /etc/snmp/snmpd.local.conf, which snmpd reads after the
snmpd.conf that every package install rewrites, and restart a running snmpd only
when that file changes.  LAN_* values rewrite 22-eth0.network last and restart
wifi_lan_apply.service, which reconfigures eth0 only after a short wait so this
reply leaves first.  Per-key results go to /home/admin/wconfig.result.
"""

import errno
import ipaddress
import json
import os
import re
import secrets
import stat
import subprocess
import sys
import syslog
import tempfile
import time
import unicodedata
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from ftpcmd_log import log_start


HOME = Path("/home/admin")
SETTINGS = "wconfig.txt"
RESULT = "wconfig.result"
JSON_PATH = Path("/usr/local/etc/wifi_init_conf.json")
TIMESYNCD_CONF = Path("/etc/systemd/timesyncd.conf")
SNMPD_LOCAL_CONF = Path("/etc/snmp/snmpd.local.conf")
APPLY_ENABLED = "/usr/local/scripts/wifi_apply_enabled.sh"
SYSTEMCTL = "/usr/bin/systemctl"
NTP_UNIT = "systemd-timesyncd.service"
SNMP_UNIT = "snmpd.service"
ETH0_NETWORK = Path("/etc/systemd/network/22-eth0.network")
MLAN0_NETWORK = Path("/etc/systemd/network/20-mlan0.network")
LAN_UNIT = "wifi_lan_apply.service"
MAX_BYTES = 64 * 1024
# The dispatcher relays one printable ASCII line of at most this many bytes (1.1).
REPLY_BYTES = 256

# The 25 system keys of the CONTEC settings export.  IMPLEMENTED keys are applied
# here; PENDING keys get their appliers in later #464 changes; UNSUPPORTED keys
# have no matching function on this device (#463).  Any other key is unknown.
LAN_KEYS = ("LAN_MODE", "LAN_IPADDR", "LAN_NETMASK", "LAN_GATEWAY")
# Per-type trap switches and the snmp.trap key each one owns.
TRAP_TYPES = (("SNMP_TRAP_WLAN", "link"), ("SNMP_TRAP_CHAN", "channel"))
# SNMP strings kept in snmpd.local.conf, and the snmpd directive each sys* key owns.
SNMPD_DIRECTIVES = (("SNMP_SYSCONTACT", "syscontact"), ("SNMP_SYSLOCATION", "syslocation"),
                    ("SNMP_SYSNAME", "sysname"))
SNMPD_KEYS = ("SNMP_COMMUNITY",) + tuple(key for key, _ in SNMPD_DIRECTIVES)
IMPLEMENTED = ("NTP_FUNC", "NTP_SERVER", "SNMP_FUNC", "SNMP_TRAP_IPADDR",
               "SNMP_TRAP_WLAN", "SNMP_TRAP_CHAN") + SNMPD_KEYS + LAN_KEYS
PENDING = ("TIMEZONE",)
UNSUPPORTED = ("LANGUAGE", "SNMP_TRAP_LAN", "SNMP_TRAP_INITSW", "NTP_INTERVAL", "LOG_FUNC",
               "LOG_SERVER", "LOG_DEBUG", "LOG_SAVE", "LOG_INTERVAL", "LAN_PORTSPEED")
KNOWN = IMPLEMENTED + PENDING + UNSUPPORTED
# "scheduled" marks LAN_* keys: eth0 changes after the FTP reply (LAN_UNIT).
STATUSES = ("applied", "unchanged", "scheduled", "failed", "invalid", "pending", "unsupported", "unknown")
# Keys whose service must follow them, and the keys that change an enable state.
# The trap switches move snmp.trap.enabled, which decides whether wifi_event@ is enabled;
# the trap sender itself reads the JSON on every trap, so they need no unit action.
SERVICE_KEYS = ((NTP_UNIT, ("NTP_FUNC", "NTP_SERVER")), (SNMP_UNIT, ("SNMP_FUNC",)))
ENABLE_KEYS = ("NTP_FUNC", "SNMP_FUNC", "SNMP_TRAP_WLAN", "SNMP_TRAP_CHAN")
TRUE_WORDS = ("true", "TRUE", "True", "1", "yes", "YES", "Yes")

EXIT_IO, EXIT_USAGE, EXIT_INVALID, EXIT_FAILED, EXIT_PENDING = 1, 2, 3, 4, 5
USAGE = "Usage: quote wconfig get [KEY] | put KEY=VALUE | apply"


class Invalid(ValueError):
    """A value the device cannot apply."""


class NotRegular(OSError):
    """The settings name is a link or a special file; it is never followed."""


def log(detail, priority=syslog.LOG_ERR):
    try:
        syslog.syslog(priority, f"ftpcmd_result command=wconfig {detail}")
    except OSError:
        pass


def fail(code, detail):
    log(f"status=fail code={code} detail={detail}")
    print(f"wconfig: {detail}", file=sys.stderr)
    return code


def run(argv, timeout, **extra_env):
    # FTP's PID namespace can hide PID 1's private-bus peer credentials, so
    # systemctl (also inside wifi_apply_enabled.sh) must use the public bus.
    environment = {**os.environ, "SYSTEMCTL_FORCE_BUS": "1", **extra_env}
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout,
                              env=environment).returncode
    except (OSError, subprocess.TimeoutExpired) as error:
        log(f"status=command_unavailable command={argv[0]} detail={error}")
        return None


# --- files in the FTP account's home -------------------------------------------------

def open_home():
    return os.open(HOME, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)


def read_home(name):
    """Text of a regular file in HOME, or None when it is absent; links are not followed."""
    dir_fd = open_home()
    try:
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                         dir_fd=dir_fd)
        except FileNotFoundError:
            return None
        except OSError as error:
            if error.errno == errno.ELOOP:
                raise NotRegular(errno.ELOOP, f"{name} is a symbolic link") from None
            raise
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise NotRegular(errno.EINVAL, f"{name} is not a regular file")
            chunks, total = [], 0
            while True:
                chunk = os.read(fd, MAX_BYTES + 1 - total)
                if not chunk:
                    break
                chunks.append(chunk)
                total += len(chunk)
                if total > MAX_BYTES:
                    raise OSError(errno.EFBIG, f"{name} is larger than {MAX_BYTES} bytes")
        finally:
            os.close(fd)
    finally:
        os.close(dir_fd)
    # Values of keys this device ignores may use any encoding; keep their bytes.
    return b"".join(chunks).decode("utf-8", "surrogateescape")


def write_home(name, text):
    """Replace NAME in HOME without following links, owned by the home's owner."""
    data = text.encode("utf-8", "surrogateescape")
    dir_fd = open_home()
    temporary = None
    try:
        # Every FTP session has its own PID namespace, so a PID-based name could be
        # another session's file in flight; a random name is never shared or removed.
        for _ in range(8):
            candidate = f".{name}.{secrets.token_hex(8)}.tmp"
            try:
                fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                             0o644, dir_fd=dir_fd)
            except FileExistsError:
                continue
            temporary = candidate
            break
        else:
            raise OSError(errno.EEXIST, f"no free temporary name for {name}")
        try:
            # The handler runs as root; hand the file to the account so that a
            # later "ftp put" can replace it (as opcd does for iplist.txt).
            home = os.fstat(dir_fd)
            if os.geteuid() == 0 and home.st_uid != 0:
                os.fchown(fd, home.st_uid, home.st_gid)
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(temporary, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        os.fsync(dir_fd)
    except BaseException:
        if temporary is not None:
            try:
                os.unlink(temporary, dir_fd=dir_fd)
            except OSError:
                pass
        raise
    finally:
        os.close(dir_fd)


def parse(text):
    """Entries (line, key, value) and the numbers of lines that are not KEY=VALUE."""
    if text.startswith("\ufeff"):
        text = text[1:]
    entries, malformed = [], []
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if not separator or not key:
            malformed.append(number)
            continue
        entries.append((number, key, value))
    return entries, malformed


# --- device stores -------------------------------------------------------------------

def replace_file(path, text):
    """Atomically replace PATH keeping its owner and mode, as wntp does."""
    try:
        info = path.lstat()
    except FileNotFoundError:
        info = None
    else:
        if not stat.S_ISREG(info.st_mode):
            raise OSError(f"{path} is not a regular file")
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            if info is not None:
                os.fchown(stream.fileno(), info.st_uid, info.st_gid)
            os.fchmod(stream.fileno(), stat.S_IMODE(info.st_mode) if info else 0o644)
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def trap_on(data, kind):
    """A trap type is sent only while traps are on and its own switch (null = on) is on."""
    return json_switch(data, ("snmp", "trap", "enabled"), False) and json_switch(data, ("snmp", "trap", kind), True)


def json_switch(data, path, default):
    """wifi_apply_enabled.sh get_bool: null or missing -> default, else tostring in TRUE_WORDS."""
    node = data
    for part in path:
        if not isinstance(node, dict) or node.get(part) is None:
            return default
        node = node[part]
    if isinstance(node, bool):
        text = "true" if node else "false"
    elif isinstance(node, str):
        text = node
    else:
        text = json.dumps(node)
    return text in TRUE_WORDS


def trap_destination(data):
    node = data.get("snmp") if isinstance(data, dict) else None
    node = node.get("trap") if isinstance(node, dict) else None
    dest = node.get("dest") if isinstance(node, dict) else ""
    return dest if isinstance(dest, str) else ""


def trap_community(data):
    """snmp.trap.community as wifi_snmp_trap.sh reads it (jq: .snmp.trap.community // "public")."""
    node = data.get("snmp") if isinstance(data, dict) else None
    node = node.get("trap") if isinstance(node, dict) else None
    value = node.get("community") if isinstance(node, dict) else None
    if value is None or value is False:
        return "public"
    return value if isinstance(value, str) else json.dumps(value)


def split_destination(dest):
    """'host:port' -> ('host', ':port'); anything else keeps its text as the host."""
    if dest.count(":") == 1:
        host, _, port = dest.partition(":")
        return host, ":" + port
    return dest, ""


def save_json(changes):
    """Re-read the settings JSON just before writing and change only CHANGES."""
    if not stat.S_ISREG(JSON_PATH.lstat().st_mode):
        raise OSError(f"{JSON_PATH} is not a regular file")
    data = json.loads(JSON_PATH.read_text(encoding="utf-8"))
    for path, value in changes:
        node = data
        for part in path[:-1]:
            child = node.get(part)
            if not isinstance(child, dict):
                child = node[part] = {}
            node = child
        node[path[-1]] = value
    replace_file(JSON_PATH, json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def records(text):
    """Keep original text while joining systemd continuation lines for parsing (as wntp)."""
    raw, parts = [], []
    for line in text.splitlines(keepends=True):
        raw.append(line)
        value = line.strip()
        if value.startswith(("#", ";")):
            if parts:
                continue
            yield "".join(raw), ""
        elif value.endswith("\\"):
            parts.append(value[:-1])
            continue
        else:
            parts.append(value)
            yield "".join(raw), " ".join(parts)
        raw, parts = [], []
    if raw:
        yield "".join(raw), " ".join(parts)


def time_values(text, name):
    """Effective list for NAME in [Time], or None when it is never assigned."""
    values, seen, in_time = [], False, False
    for _, line in records(text):
        if line.startswith("[") and line.endswith("]"):
            in_time = line == "[Time]"
        elif in_time:
            key, separator, value = line.partition("=")
            if separator and key.strip() == name:
                seen = True
                # An empty assignment resets the list in systemd configuration.
                values = values + value.split() if value.split() else []
    return values if seen else None


def set_time_values(text, assignments):
    output, written, in_time = [], set(), False
    for raw, line in records(text):
        if line.startswith("[") and line.endswith("]"):
            in_time = line == "[Time]"
        key, separator, _ = line.partition("=")
        key = key.strip()
        if in_time and separator and key in assignments:
            if key not in written:
                output.append(f"{key}={assignments[key]}\n")
                written.add(key)
            continue
        output.append(raw)
    result = "".join(output)
    missing = [key for key in assignments if key not in written]
    if missing:
        if result and not result.endswith("\n"):
            result += "\n"
        if not in_time:
            result += "[Time]\n"
        result += "".join(f"{key}={assignments[key]}\n" for key in missing)
    return result


def ntp_server(text):
    """First device server (NTP=), or 0.0.0.0 when none is set; FallbackNTP= is not a device server."""
    servers = time_values(text, "NTP") or []
    return servers[0] if servers else "0.0.0.0"


def read_timesyncd():
    try:
        return TIMESYNCD_CONF.read_text(encoding="utf-8")
    except FileNotFoundError:
        return ""


def read_snmpd_local():
    """Text of snmpd.local.conf, or None when it is absent; bytes that are not UTF-8 are kept."""
    try:
        return SNMPD_LOCAL_CONF.read_bytes().decode("utf-8", "surrogateescape")
    except FileNotFoundError:
        return None


def snmpd_words(line):
    """(directive in lower case, rest of the line) of an snmpd.conf line, or None for a comment
    or a blank line.  snmpd drops trailing blanks and joins no continuation lines."""
    words = line.split(None, 1)
    if not words or words[0].startswith("#"):
        return None
    return words[0].lower(), words[1].rstrip() if len(words) > 1 else ""


def snmpd_values(text):
    """SNMP strings as get reports them: the community of the first rocommunity line, and the
    last line of each sys* directive, which is the one snmpd keeps.  Missing means empty."""
    values, community = {key: "" for key, _ in SNMPD_DIRECTIVES}, None
    for line in (text or "").split("\n"):
        words = snmpd_words(line)
        if words is None:
            continue
        name, rest = words
        if name == "rocommunity" and community is None:
            community = rest.split()[0] if rest.split() else ""
        for key, directive in SNMPD_DIRECTIVES:
            if name == directive:
                values[key] = rest
    return {"SNMP_COMMUNITY": community or "", **values}


def set_snmpd_values(text, assignments):
    """snmpd.local.conf with ASSIGNMENTS {key: value} applied.

    The community replaces only the community word of every rocommunity line, so a source or
    OID narrowed by hand stays, and "rocommunity VALUE default" is added when there is none.
    A sys* value replaces every line of its directive with one line where the first was (or
    at the end); an empty value removes them, so snmpd falls back to its default."""
    lines = text.split("\n")
    if lines[-1] == "":
        lines.pop()
    owner = {directive: key for key, directive in SNMPD_DIRECTIVES if key in assignments}
    community = assignments.get("SNMP_COMMUNITY")
    output, placed, communities = [], set(), 0
    for line in lines:
        words = snmpd_words(line)
        name = words[0] if words else None
        if name == "rocommunity" and community is not None:
            match = re.match(r"(\s*\S+\s+)\S+(.*)", line)
            line = match.group(1) + community + match.group(2) if match else f"rocommunity {community} default"
            communities += 1
        elif name in owner:
            key = owner[name]
            if key not in placed and assignments[key]:
                output.append(f"{name} {assignments[key]}")
            placed.add(key)
            continue
        output.append(line)
    if community is not None and not communities:
        output.append(f"rocommunity {community} default")
    for key, directive in SNMPD_DIRECTIVES:
        if key in assignments and key not in placed and assignments[key]:
            output.append(f"{directive} {assignments[key]}")
    return "".join(line + "\n" for line in output)


def read_network(path):
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return ""


def network_entries(text, name):
    """Values of NAME in [Network] of a systemd-networkd file, in file order."""
    values, in_network = [], False
    for _, line in records(text):
        if line.startswith("[") and line.endswith("]"):
            in_network = line == "[Network]"
        elif in_network:
            key, separator, value = line.partition("=")
            if separator and key.strip() == name:
                values.append(value.strip())
    return values


def lan_values(text):
    """LAN_* as get reports them: the first Address= and Gateway=, as wifi.sh ip/gt edit them."""
    dhcp = network_entries(text, "DHCP")
    mode = dhcp[-1] if dhcp else "no"
    addresses, gateways = network_entries(text, "Address"), network_entries(text, "Gateway")
    address, netmask = "0.0.0.0", "0.0.0.0"
    if addresses:
        try:
            interface = ipaddress.IPv4Interface(addresses[0])
        except ValueError:
            address = addresses[0]
        else:
            address, netmask = str(interface.ip), str(interface.netmask)
    return {
        "LAN_MODE": "static" if mode.lower() in ("no", "false", "0", "off") else mode,
        "LAN_IPADDR": address,
        "LAN_NETMASK": netmask,
        "LAN_GATEWAY": gateways[0] if gateways else "0.0.0.0",
    }


def set_network_values(text, assignments):
    """Rewrite [Network] keys as wifi.sh ip/gt do: the first line of a key takes the value
    and later lines of it go; a None value removes the key; a missing key ends the section."""
    output, handled, in_network, seen_network = [], set(), False, False

    def add_missing():
        for key, value in assignments.items():
            if key not in handled and value is not None:
                output.append(f"{key}={value}\n")
                handled.add(key)

    for raw, line in records(text):
        if line.startswith("[") and line.endswith("]"):
            if in_network:
                add_missing()
            in_network = line == "[Network]"
            seen_network = seen_network or in_network
            output.append(raw)
            continue
        key, separator, _ = line.partition("=")
        key = key.strip()
        if in_network and separator and key in assignments:
            if key not in handled and assignments[key] is not None:
                output.append(f"{key}={assignments[key]}\n")
            handled.add(key)
            continue
        output.append(raw)
    if output and not output[-1].endswith("\n"):
        output[-1] += "\n"
    if not seen_network:
        output.append("[Network]\n")
        in_network = True
    if in_network:
        add_missing()
    return "".join(output)


def current_values():
    data = json.loads(JSON_PATH.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise ValueError("settings JSON is not an object")
    host, _ = split_destination(trap_destination(data))
    return data, {
        "NTP_FUNC": "enabled" if json_switch(data, ("global", "ntp", "enabled"), True) else "disabled",
        "NTP_SERVER": ntp_server(read_timesyncd()),
        "SNMP_FUNC": "enabled" if json_switch(data, ("snmp", "enabled"), False) else "disabled",
        "SNMP_TRAP_IPADDR": host or "0.0.0.0",
        **{key: "enabled" if trap_on(data, kind) else "disabled" for key, kind in TRAP_TYPES},
        **snmpd_values(read_snmpd_local()),
        **lan_values(read_network(ETH0_NETWORK)),
    }


def check_switch(value):
    if value in ("enabled", "disabled"):
        return value
    raise Invalid("expected enabled or disabled")


def check_address(value):
    if value == "0.0.0.0":
        return value
    try:
        address = ipaddress.IPv4Address(value)
    except ValueError:
        raise Invalid("expected an IPv4 address or 0.0.0.0") from None
    if address.is_multicast or address.is_unspecified or str(address) == "255.255.255.255":
        raise Invalid("expected a unicast IPv4 address or 0.0.0.0")
    return str(address)


def check_mode(value):
    if value == "static":
        return value
    raise Invalid("expected static; DHCP is not supported")


def check_host(value):
    """A unicast host address: not 0/8, loopback, multicast or the reserved block above it."""
    try:
        address = ipaddress.IPv4Address(value)
    except ValueError:
        raise Invalid("expected an IPv4 address") from None
    if address in ipaddress.IPv4Network("0.0.0.0/8") or address.is_loopback or int(address) >= 0xE0000000:
        raise Invalid("expected a unicast host address")
    return str(address)


def check_netmask(value):
    """A dotted mask from /8 to /30: /31 and /32 leave no LAN, and wifi_init.sh deletes eth0's /32s."""
    try:
        mask = ipaddress.IPv4Address(value)
        prefix = ipaddress.IPv4Network(f"0.0.0.0/{mask}").prefixlen
    except ValueError:
        raise Invalid("expected a dotted netmask such as 255.255.255.0") from None
    if str(ipaddress.IPv4Network(f"0.0.0.0/{prefix}").netmask) != str(mask):
        # ipaddress also takes a host mask such as 0.0.0.255; a LAN netmask is never one.
        raise Invalid("expected a dotted netmask such as 255.255.255.0")
    if not 8 <= prefix <= 30:
        raise Invalid("expected a netmask from 255.0.0.0 to 255.255.255.252")
    return str(mask)


def check_gateway(value):
    return value if value == "0.0.0.0" else check_host(value)


def check_community(value):
    """The query and trap community: 1 to 32 visible ASCII characters other than # " ' \\."""
    if not 1 <= len(value) <= 32 or any(not "!" <= char <= "~" or char in "#\"'\\" for char in value):
        raise Invalid("expected 1 to 32 visible ASCII characters other than # \" ' \\")
    return value


def check_snmp_text(value):
    """A sys* string as snmpd keeps it: UTF-8 without control characters, at most 255 bytes
    (snmpd drops a longer token), not starting with # (snmpd reads no value).  parse() has
    already removed surrounding blanks; empty means the default."""
    for char in value:
        category = unicodedata.category(char)
        if category == "Cs":
            # read_home keeps bytes that are not UTF-8 as lone surrogates.
            raise Invalid("expected UTF-8 text")
        if category in ("Cc", "Zl", "Zp"):
            raise Invalid("control characters are not allowed")
    if value.startswith("#"):
        raise Invalid("must not start with #")
    if len(value.encode("utf-8")) > 255:
        raise Invalid("expected at most 255 bytes")
    return value


CHECKS = {"NTP_FUNC": check_switch, "NTP_SERVER": check_address,
          "SNMP_FUNC": check_switch, "SNMP_TRAP_IPADDR": check_address,
          "SNMP_TRAP_WLAN": check_switch, "SNMP_TRAP_CHAN": check_switch,
          "SNMP_COMMUNITY": check_community, "SNMP_SYSCONTACT": check_snmp_text,
          "SNMP_SYSLOCATION": check_snmp_text, "SNMP_SYSNAME": check_snmp_text,
          "LAN_MODE": check_mode, "LAN_IPADDR": check_host, "LAN_NETMASK": check_netmask,
          "LAN_GATEWAY": check_gateway}


def lan_network(values):
    """eth0's subnet for these LAN values, or None when they do not form one."""
    if values["LAN_IPADDR"] == "0.0.0.0":
        return None
    try:
        return ipaddress.IPv4Network(f"{values['LAN_IPADDR']}/{values['LAN_NETMASK']}", strict=False)
    except ValueError:
        return None


def mlan0_networks():
    """mlan0's subnets: its live addresses and its static Address= (it may be down now).

    A /32 is not a subnet (the peer_route mirror), as in opcd's management-plane guard.
    """
    try:
        result = subprocess.run(["ip", "-4", "-o", "addr", "show", "dev", "mlan0"],
                                capture_output=True, text=True, timeout=4)
        words = result.stdout.split() if result.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired) as error:
        log(f"status=command_unavailable command=ip detail={error}")
        words = []
    cidrs = [words[index + 1] for index, word in enumerate(words[:-1]) if word == "inet"]
    cidrs += network_entries(read_network(MLAN0_NETWORK), "Address")
    found = []
    for cidr in cidrs:
        try:
            network = ipaddress.IPv4Interface(cidr).network
        except ValueError:
            continue
        if network.prefixlen < 32:
            found.append(network)
    return found


def check_lan(current, wanted):
    """Why the LAN values would not work together, or None.  Called only when one changes,
    so a file written by get still applies whatever has changed around eth0 since."""
    target = {key: wanted.get(key, current[key]) for key in LAN_KEYS}
    if target["LAN_MODE"] != "static":
        return f"eth0 is {target['LAN_MODE']}; add LAN_MODE=static"
    for key, check in (("LAN_IPADDR", check_host), ("LAN_NETMASK", check_netmask),
                       ("LAN_GATEWAY", check_gateway)):
        try:
            check(target[key])
        except Invalid as error:
            return f"{key} {target[key]}: {error}"
    network = lan_network(target)
    address = ipaddress.IPv4Address(target["LAN_IPADDR"])
    if address in (network.network_address, network.broadcast_address):
        return f"LAN_IPADDR {address} is the network or broadcast address of {network}"
    if target["LAN_GATEWAY"] != "0.0.0.0":
        gateway = ipaddress.IPv4Address(target["LAN_GATEWAY"])
        if gateway not in network or gateway in (address, network.network_address, network.broadcast_address):
            return f"LAN_GATEWAY {gateway} must be another host in {network}"
    if network != lan_network(current):
        # Management IP rule (opcd ipcfg_clashes_other_iface): eth0 and mlan0 never share
        # a subnet, compared under the shorter prefix.
        for other in mlan0_networks():
            if network.overlaps(other):
                return f"eth0 subnet {network} overlaps mlan0 {other}; keep them on different subnets"
    return None


# --- commands ------------------------------------------------------------------------

def compare_values(document, current):
    """CURRENT for classify, except that SNMP_COMMUNITY differs while the trap community does:
    the key sets both, and the web UI edits snmp.trap.community alone.  A community wconfig
    could not write (none at all, say) stays as it is, so a file written by get still applies."""
    community = current["SNMP_COMMUNITY"]
    if community == trap_community(document):
        return current
    try:
        check_community(community)
    except Invalid:
        return current
    return {**current, "SNMP_COMMUNITY": None}


def classify(entries, malformed, current):
    """Per-key report in file order and the implemented values that would change."""
    lines_of = {}
    for number, key, _ in entries:
        if key in KNOWN:
            lines_of.setdefault(key, []).append(number)
    report, wanted, seen = [], {}, set()
    for _, key, value in entries:
        if key in seen:
            continue
        seen.add(key)
        if len(lines_of.get(key, ())) > 1:
            report.append([key, "invalid", "duplicate key on lines " + ",".join(map(str, lines_of[key]))])
        elif key in UNSUPPORTED:
            report.append([key, "unsupported", ""])
        elif key in PENDING:
            report.append([key, "pending", ""])
        elif key not in IMPLEMENTED:
            report.append([key, "unknown", ""])
        elif value == current[key]:
            report.append([key, "unchanged", ""])
        else:
            try:
                normalized = CHECKS[key](value)
            except Invalid as error:
                report.append([key, "invalid", str(error)])
                continue
            if normalized == current[key]:
                report.append([key, "unchanged", ""])
            else:
                wanted[key] = normalized
                report.append([key, "applied", ""])
    changed = [key for key in LAN_KEYS if key in wanted]
    if changed and not any(entry[0] in LAN_KEYS and entry[1] == "invalid" for entry in report):
        error = check_lan(current, wanted)
        if error:
            for entry in report:
                if entry[0] in changed:
                    entry[1], entry[2] = "invalid", error
            for key in changed:
                del wanted[key]
    report.extend([f"line{number}", "invalid", "expected KEY=VALUE"] for number in malformed)
    return report, wanted


def save_stores(document, wanted, status):
    changes, json_keys = [], []
    for key, path in (("NTP_FUNC", ("global", "ntp", "enabled")), ("SNMP_FUNC", ("snmp", "enabled"))):
        if key in wanted:
            changes.append((path, wanted[key] == "enabled"))
            json_keys.append(key)
    if "SNMP_TRAP_IPADDR" in wanted:
        host = wanted["SNMP_TRAP_IPADDR"]
        _, port = split_destination(trap_destination(document))
        changes.append((("snmp", "trap", "dest"), "" if host == "0.0.0.0" else host + port))
        json_keys.append("SNMP_TRAP_IPADDR")
    trap_keys = [key for key, _ in TRAP_TYPES if key in wanted]
    if trap_keys:
        # A type not in the file keeps the state it was reported in (on only while traps are on).
        target = {kind: wanted[key] == "enabled" if key in wanted else trap_on(document, kind)
                  for key, kind in TRAP_TYPES}
        if any(target.values()):
            changes.append((("snmp", "trap", "enabled"), True))
            changes.extend((("snmp", "trap", kind), on) for kind, on in target.items())
        else:
            # Both off: switch traps off and keep each type's own switch, so turning
            # snmp.trap.enabled back on elsewhere (web UI) sends them again.
            changes.append((("snmp", "trap", "enabled"), False))
        json_keys.extend(trap_keys)
    if "SNMP_COMMUNITY" in wanted:
        # The trap community goes first: when it fails, apply_snmpd leaves the query one.
        changes.append((("snmp", "trap", "community"), wanted["SNMP_COMMUNITY"]))
        json_keys.append("SNMP_COMMUNITY")
    if changes:
        try:
            save_json(changes)
        except (OSError, ValueError) as error:
            for key in json_keys:
                status[key] = ("failed", f"settings save failed: {error}")
    if "NTP_SERVER" in wanted:
        server = wanted["NTP_SERVER"]
        # 0.0.0.0 clears the device server only.  timesyncd then uses FallbackNTP=, and
        # systemd 254 refills an empty FallbackNTP= with its compiled default list, so
        # no file setting means "no server"; NTP_FUNC=disabled stops time sync.
        assignments = {"NTP": "" if server == "0.0.0.0" else server}
        try:
            replace_file(TIMESYNCD_CONF, set_time_values(read_timesyncd(), assignments))
        except (OSError, UnicodeError) as error:
            status["NTP_SERVER"] = ("failed", f"timesyncd save failed: {error}")


def follow_services(present, wanted, status):
    """One --no-block action per service, chosen from its enable state after the sync."""
    sync_failed = False
    if any(key in present for key in ENABLE_KEYS):
        rc = run([APPLY_ENABLED], 12, WIFI_APPLY_STRICT="1")
        if rc != 0:
            sync_failed = True
            for key in ENABLE_KEYS:
                if key in present:
                    status[key] = ("failed", f"enable state sync failed rc={rc}")
    for unit, keys in SERVICE_KEYS:
        keys = [key for key in keys if key in present]
        if not keys:
            continue
        if sync_failed and any(key in ENABLE_KEYS for key in keys):
            # The enable state is unknown, so the service is left alone; every key
            # that needed this service stays failed until a later apply succeeds.
            for key in keys:
                status.setdefault(key, ("failed", f"{unit} not changed after the enable state sync failed"))
            continue
        enabled = run([SYSTEMCTL, "is-enabled", "--quiet", unit], 4)
        if enabled is None:
            action, rc = "is-enabled", None
        else:
            if enabled != 0:
                action = "stop"
            elif "NTP_SERVER" in keys:
                # timesyncd reads its servers only at start; restarting whenever the
                # key is listed also completes an earlier apply whose restart failed.
                action = "restart"
            else:
                action = "start"
            rc = run([SYSTEMCTL, "--no-ask-password", "--no-block", action, unit], 4)
        if rc != 0:
            for key in keys:
                status.setdefault(key, ("failed", f"{action} {unit} failed rc={rc}"))


def apply_snmpd(wanted, status):
    """Rewrite snmpd.local.conf for the SNMP strings that changed and have a running snmpd reread it.

    Only a changed file restarts snmpd, because a restart resets sysUpTime and drops queries
    for a moment.  try-restart restarts a running snmpd and leaves a stopped one, which reads the
    file when it next starts, so no enable-state lookup is needed: is-enabled exits 1 both for a
    disabled unit and for an unreachable systemd.  A try-restart that cannot be queued puts the
    file back, so failed means snmpd still has the old values and applying the same file again
    retries."""
    keys = [key for key in SNMPD_KEYS if key in wanted and key not in status]
    if not keys:
        return
    try:
        before = read_snmpd_local()
        after = set_snmpd_values(before or "", {key: wanted[key] for key in keys})
        if after == (before or ""):
            return
        replace_file(SNMPD_LOCAL_CONF, after)
    except (OSError, UnicodeError) as error:
        for key in keys:
            status[key] = ("failed", f"snmpd.local.conf save failed: {error}")
        return
    rc = run([SYSTEMCTL, "--no-ask-password", "--no-block", "try-restart", SNMP_UNIT], 4)
    if rc == 0:
        return
    try:
        if before is None:
            SNMPD_LOCAL_CONF.unlink()
        else:
            replace_file(SNMPD_LOCAL_CONF, before)
    except (OSError, UnicodeError) as error:
        detail = f"try-restart {SNMP_UNIT} failed rc={rc}; restoring snmpd.local.conf failed ({error})"
    else:
        detail = f"try-restart {SNMP_UNIT} failed rc={rc}; snmpd.local.conf restored"
    for key in keys:
        status[key] = ("failed", detail)


def apply_lan(wanted, current, status):
    """Rewrite eth0's [Network] and hand the reconfigure to LAN_UNIT, which waits for this reply."""
    keys = [key for key in LAN_KEYS if key in wanted]
    if not keys:
        return
    target = {key: wanted.get(key, current[key]) for key in LAN_KEYS}
    assignments = {
        "DHCP": "no",
        "Address": f"{target['LAN_IPADDR']}/{lan_network(target).prefixlen}",
        "Gateway": None if target["LAN_GATEWAY"] == "0.0.0.0" else target["LAN_GATEWAY"],
    }
    try:
        before = ETH0_NETWORK.read_text(encoding="utf-8")
        replace_file(ETH0_NETWORK, set_network_values(before, assignments))
    except (OSError, UnicodeError) as error:
        for key in keys:
            status[key] = ("failed", f"eth0 network save failed: {error}")
        return
    rc = run([SYSTEMCTL, "--no-ask-password", "--no-block", "restart", LAN_UNIT], 4)
    if rc == 0:
        for key in keys:
            status[key] = ("scheduled", f"eth0 changes after this reply ({LAN_UNIT})")
        return
    # Restore so that failed means eth0 is unchanged: applying the same file then retries,
    # whereas a kept file would read as unchanged and change eth0 only at the next boot.
    try:
        replace_file(ETH0_NETWORK, before)
    except (OSError, UnicodeError) as error:
        detail = (f"restart {LAN_UNIT} failed rc={rc}; restoring 22-eth0.network failed ({error}), "
                  "the saved values apply at the next boot (quote rst)")
    else:
        detail = f"restart {LAN_UNIT} failed rc={rc}; 22-eth0.network restored"
    for key in keys:
        status[key] = ("failed", detail)


def write_result(report, counts):
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    summary = "SUMMARY " + " ".join(f"{name}={counts[name]}" for name in STATUSES)
    lines = [" ".join(part for part in entry if part) for entry in report]
    write_home(RESULT, "\n".join([f"# wconfig apply {stamp}", summary, *lines]) + "\n")
    return summary


def apply_settings():
    try:
        text = read_home(SETTINGS)
    except OSError as error:
        return fail(EXIT_IO, f"cannot read {SETTINGS}: {error}")
    if text is None:
        return fail(EXIT_IO, f"{SETTINGS} not found; upload it or run wconfig get")
    try:
        document, current = current_values()
    except (OSError, ValueError) as error:
        return fail(EXIT_IO, f"cannot read the device settings: {error}")
    report, wanted = classify(*parse(text), compare_values(document, current))
    invalid = [entry for entry in report if entry[1] == "invalid"]
    if invalid:
        counts = {name: 0 for name in STATUSES}
        counts["invalid"] = len(invalid)
        try:
            summary = write_result(invalid, counts)
        except OSError as error:
            return fail(EXIT_IO, f"nothing changed; result save failed: {error}")
        return fail(EXIT_INVALID, f"nothing changed; {summary}")

    status = {}
    save_stores(document, wanted, status)
    present = {entry[0] for entry in report if entry[0] in IMPLEMENTED}
    follow_services(present, wanted, status)
    apply_snmpd(wanted, status)
    # Last, so the unit's wait starts only when nothing but the reply is left to do.
    apply_lan(wanted, current, status)
    for entry in report:
        if entry[0] in status:
            entry[1], entry[2] = status[entry[0]]
    counts = {name: 0 for name in STATUSES}
    for entry in report:
        counts[entry[1]] += 1
    try:
        summary = write_result(report, counts)
    except OSError as error:
        return fail(EXIT_IO, f"applied but the result save failed: {error}")
    if counts["failed"]:
        return fail(EXIT_FAILED, summary)
    if counts["pending"]:
        return fail(EXIT_PENDING, summary)
    log(f"status=ok {summary}", syslog.LOG_INFO)
    print("SUCCESS " + summary[len("SUMMARY "):] + f"; see {RESULT}")
    return 0


def get_settings(key=None):
    if key is not None and key not in IMPLEMENTED:
        return fail(EXIT_USAGE, f"{key} cannot be read; readable keys: {' '.join(IMPLEMENTED)}")
    try:
        _, current = current_values()
    except (OSError, ValueError) as error:
        return fail(EXIT_IO, f"cannot read the device settings: {error}")
    if key is not None:
        line = f"{key}={current[key]}"
        if not (line.isascii() and line.isprintable()) or len(line) > REPLY_BYTES:
            # Such a value (Korean, say) is only written with ftp put; it is read the same way.
            return fail(EXIT_USAGE, f"{key} does not fit the reply line; run wconfig get and read {SETTINGS}")
        print(line)
        return 0
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    lines = [f"# wconfig get {stamp}"] + [f"{name}={current[name]}" for name in IMPLEMENTED]
    try:
        write_home(SETTINGS, "\n".join(lines) + "\n")
    except OSError as error:
        return fail(EXIT_IO, f"cannot write {SETTINGS}: {error}")
    print(f"SUCCESS wrote {len(IMPLEMENTED)} keys to {SETTINGS}")
    return 0


def valid_key(key):
    return bool(key) and key[0].isascii() and key[0].isupper() and all(
        char.isascii() and (char.isupper() or char.isdigit() or char == "_") for char in key)


def put_setting(args):
    key, separator, value = args[0].partition("=")
    if not separator or not valid_key(key):
        return fail(EXIT_USAGE, "expected KEY=VALUE with an upper-case key; " + USAGE)
    value = " ".join([value, *args[1:]]).strip()
    try:
        text = read_home(SETTINGS) or ""
    except NotRegular as error:
        # A planted link or special file is replaced, never read or followed.
        log(f"status=replaced_non_regular detail={error}")
        text = ""
    except OSError as error:
        return fail(EXIT_IO, f"cannot read {SETTINGS}: {error}")
    if text.startswith("\ufeff"):
        text = text[1:]
    lines, written = [], False
    for line in text.splitlines():
        name, has_equals, _ = line.strip().partition("=")
        if has_equals and name.strip() == key:
            if not written:
                lines.append(f"{key}={value}")
                written = True
            continue
        lines.append(line)
    if not written:
        lines.append(f"{key}={value}")
    try:
        write_home(SETTINGS, "\n".join(lines) + "\n")
    except OSError as error:
        return fail(EXIT_IO, f"cannot write {SETTINGS}: {error}")
    print(f"SUCCESS {key} saved to {SETTINGS}; run wconfig apply")
    return 0


def main(args=None):
    log_start("wconfig")
    args = sys.argv[1:] if args is None else args
    if args == ["apply"]:
        return apply_settings()
    if args == ["get"]:
        return get_settings()
    if len(args) == 2 and args[0] == "get":
        return get_settings(args[1])
    if len(args) >= 2 and args[0] == "put":
        return put_setting(args[1:])
    return fail(EXIT_USAGE, USAGE)


if __name__ == "__main__":
    raise SystemExit(main())
