#!/bin/sh
# Reassociate a wifi interface, optionally switching it to another SSID.
# Reached over FTP as:
#   quote wconnect <mlan0|mlan1|0|1> [--save|--no-save] [--] [ssid words...]
#
# NOT named "connect": vsftpd refuses GET/POST/HEAD/OPTIONS/CONNECT as FTP
# verbs and drops the control connection, and that check runs before the
# handler dispatch ever sees the command (postlogin.c, ahead of
# vsf_extcmd_try).  Those five names are unusable here.
#
# The first argument must select mlan0/mlan1 (0/1 are aliases). All remaining
# FTP arguments after optional save policy/separator form one SSID,
# joined with spaces, even when a word is
# numeric. With no SSID, the
# stored profile is reloaded. Frequencies are not accepted here; stage them
# with wfreq first.
#
# wconnect itself never accepts a passphrase argument. An explicit SSID normally
# rewrites only that field in the stored profile, while no SSID reloads the
# profile as stored. If wpsk staged a runtime credential, the explicit-SSID
# path tries SSID and PSK in supplicant memory and persists both only on success.
# --no-save applies only to runtime, including staged credentials; it never
# rewrites the WPA profile or OPC restore marker. The default is --save.
#
# Run by vsftpd's privileged parent, as root, with cwd / and a fixed PATH of
# /usr/sbin:/usr/bin:/sbin:/bin -- which does NOT contain /usr/local/bin, so
# wifi has to be named by its absolute path here.
#
# Timing: wifi's own association wait is ASSOC_TIMEOUT_DEFAULT (15s), and
# vsftpd kills a handler at 30s, so this stays synchronous and reports the
# real outcome.  Do not raise the wait past the vsftpd budget.
#
# Contract: the dispatch rules this relies on -- argv, the environment
# vsftpd exports, the private PID namespace, and the exit-status-to-reply-
# code mapping -- are defined by 0001-vsftpd-external-command-dispatch.patch
# in the meta-cts-wlan layer (recipes-daemons/vsftpd/vsftpd/).  Read that
# patch header before changing anything here.
set -u

WIFI=/usr/local/bin/wifi
WIFI_RUN_DIR=${WIFI_RUN_DIR:-/run/wifi}

ftpcmd_monotonic_ms() {
    IFS=' .' read -r _ftpcmd_sec _ftpcmd_centi _ftpcmd_rest < /proc/uptime \
        || return 1
    case "$_ftpcmd_sec:$_ftpcmd_centi" in
        *[!0-9:]*|:*) return 1 ;;
    esac
    _ftpcmd_centi=${_ftpcmd_centi#0}
    [ -n "$_ftpcmd_centi" ] || _ftpcmd_centi=0
    printf '%s\n' "$((_ftpcmd_sec * 1000 + _ftpcmd_centi * 10))"
}

ftpcmd_trace_log() {
    _ftpcmd_phase=$1
    shift
    case "${FTPCMD_TRACE_START_MS:-}" in ''|*[!0-9]*) return 0 ;; esac
    case "${FTPCMD_TRACE_ID:-}" in ''|*[!A-Za-z0-9._-]*) return 0 ;; esac
    _ftpcmd_now_ms=$(ftpcmd_monotonic_ms) || return 0
    _ftpcmd_elapsed_ms=$((_ftpcmd_now_ms - FTPCMD_TRACE_START_MS))
    [ "$_ftpcmd_elapsed_ms" -ge 0 ] || _ftpcmd_elapsed_ms=0
    logger -p local0.info \
        "ftpcmd_timing trace=$FTPCMD_TRACE_ID phase=$_ftpcmd_phase elapsed_ms=$_ftpcmd_elapsed_ms $*" \
        >/dev/null 2>&1 || true
}

ftpcmd_log_failure() {
    _ftpcmd_code=$1
    shift
    _ftpcmd_detail=none
    if [ "$#" -gt 0 ] && [ -n "$*" ]; then
        IFS= read -r _ftpcmd_detail <<EOF
$*
EOF
        [ -n "$_ftpcmd_detail" ] || _ftpcmd_detail=none
    fi
    logger -p local0.err \
        "ftpcmd_result trace=${FTPCMD_TRACE_ID:-none} command=wconnect status=fail code=$_ftpcmd_code iface=${IFACE:-unknown} detail=$_ftpcmd_detail" \
        >/dev/null 2>&1 || true
}

FTPCMD_TRACE_START_MS=$(ftpcmd_monotonic_ms 2>/dev/null || true)
FTPCMD_TRACE_PID=$$
if IFS= read -r _ftpcmd_self_stat < /proc/self/stat 2>/dev/null; then
    _ftpcmd_host_pid=${_ftpcmd_self_stat%% *}
    case "$_ftpcmd_host_pid" in
        ''|*[!0-9]*) ;;
        *) FTPCMD_TRACE_PID=$_ftpcmd_host_pid ;;
    esac
fi
case "$FTPCMD_TRACE_START_MS" in
    ''|*[!0-9]*) FTPCMD_TRACE_START_MS=; FTPCMD_TRACE_ID= ;;
    *) FTPCMD_TRACE_ID="${FTPCMD_TRACE_START_MS}-${FTPCMD_TRACE_PID}" ;;
esac
export FTPCMD_TRACE_START_MS FTPCMD_TRACE_ID
ftpcmd_trace_log dispatch_received "argc=$#"

IFACE=unknown
trap 'FTPCMD_RC=$?; trap - EXIT; ftpcmd_trace_log reply_ready "iface=${IFACE:-unknown} rc=$FTPCMD_RC"; if [ "$FTPCMD_RC" -eq 0 ]; then printf "SUCCESS\n"; else printf "FAIL code=%s\n" "$FTPCMD_RC"; fi; exit "$FTPCMD_RC"' EXIT
case "${1:-}" in
    mlan0|0) IFACE=mlan0 ;;
    mlan1|1) IFACE=mlan1 ;;
    *)
        ftpcmd_log_failure 2 "expected interface mlan0, mlan1, 0 or 1"
        exit 2
        ;;
esac
shift

FTPCMD_SAVE_OPTION=
FTPCMD_END_OPTIONS=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --save|--no-save)
            if [ -n "$FTPCMD_SAVE_OPTION" ]; then
                ftpcmd_log_failure 2 "specify only one save option"
                exit 2
            fi
            FTPCMD_SAVE_OPTION=$1
            shift
            ;;
        --)
            FTPCMD_END_OPTIONS=1
            shift
            break
            ;;
        --*)
            ftpcmd_log_failure 2 "unknown option; use -- before an SSID beginning with --"
            exit 2
            ;;
        *) break ;;
    esac
done

FTPCMD_HAS_SSID=0
if [ "$#" -gt 0 ]; then
    FTPCMD_HAS_SSID=1
    # Every remaining word is SSID text, numeric words included.  Frequencies
    # are staged only by wfreq, so wconnect never rewrites the freq_list.
    FTPCMD_SSID=$*
fi
ftpcmd_trace_log arguments_parsed "iface=$IFACE ssid_supplied=$FTPCMD_HAS_SSID"

# wifi's own connect subcommand only handles the two station interfaces; the
# parser above can therefore select only mlan0 or mlan1.
if [ ! -x "$WIFI" ]; then
    ftpcmd_log_failure 1 "wifi executable unavailable"
    exit 1
fi

# Refuse to reassociate the interface this very session is riding on.  The
# reply is written after the handler exits, so reassociating that interface
# loses the reply and can lock the operator out.  Same check as ifcdown; on a
# bridged board the lookup names the bridge, not mlan0, so it does not fire
# for the intended eth0-side operator.
if [ -n "${FTPCMD_LOCAL_ADDR:-}" ]; then
    CTRL_IFACE=$(ip -o addr show 2>/dev/null \
        | awk -v a="$FTPCMD_LOCAL_ADDR" '$4 ~ "^"a"(/|$)" {print $2; exit}')
    if [ "$CTRL_IFACE" = "$IFACE" ]; then
        ftpcmd_log_failure 3 "target interface carries FTP control connection"
        exit 3
    fi
fi

# Reassemble an explicit SSID as one argument. With no SSID, wifi connect
# reloads the stored profile and applies settings staged by wssid or wfreq.
ftpcmd_trace_log connect_invoked "iface=$IFACE ssid_supplied=$FTPCMD_HAS_SSID"
RUNTIME_PSK_STAGE="$WIFI_RUN_DIR/${IFACE}.runtime-psk"
RUNTIME_SWITCH_MARKER="$WIFI_RUN_DIR/${IFACE}.runtime-switch-in-progress"
FTPCMD_RUNTIME_PSK=0
# An in-progress marker owns any remaining stage file. Let wifi recover that
# transaction before treating a pending stage as a new explicit-SSID switch.
if { [ ! -e "$RUNTIME_SWITCH_MARKER" ] && [ ! -L "$RUNTIME_SWITCH_MARKER" ]; } \
   && { [ -e "$RUNTIME_PSK_STAGE" ] || [ -L "$RUNTIME_PSK_STAGE" ]; }; then
    FTPCMD_RUNTIME_PSK=1
fi
export FTPCMD_RUNTIME_PSK
set -- "$IFACE" connect
if [ -n "$FTPCMD_SAVE_OPTION" ]; then
    set -- "$@" "$FTPCMD_SAVE_OPTION"
fi
if [ "$FTPCMD_END_OPTIONS" -eq 1 ]; then
    set -- "$@" --
fi
if [ "$FTPCMD_HAS_SSID" -eq 1 ]; then
    set -- "$@" "$FTPCMD_SSID"
fi
FTPCMD_DETAIL=$(FTPCMD_APPLY_CONF=1 "$WIFI" "$@" 2>&1)
FTPCMD_RC=$?

[ "$FTPCMD_RC" -eq 0 ] || {
    ftpcmd_log_failure "$FTPCMD_RC" "$FTPCMD_DETAIL"
    exit "$FTPCMD_RC"
}
exit 0
