#!/bin/sh
# Reboot the board like rst; an optional interface is validated, not a target.
#   quote wrst [mlan0|mlan1|0|1]
set -u

case "$0" in */*) _ftpcmd_dir=${0%/*} ;; *) _ftpcmd_dir=. ;; esac
"$_ftpcmd_dir/../lib/ftpcmd_start_log" wrst >/dev/null 2>&1 || true

if [ "$#" -gt 1 ]; then
    echo "usage: wrst [mlan0|mlan1|0|1]"
    exit 2
fi
if [ "$#" -eq 1 ]; then
    case "$1" in
        mlan0|mlan1|0|1) ;;
        *) echo "invalid interface: $1"; exit 2 ;;
    esac
fi

export FTPCMD_START_LOGGED_FOR=rst
exec "$(dirname "$0")/rst"
