#!/bin/sh
# Reboot the board like rst; the required interface is validated, not a target.
#   quote wrst <mlan0|mlan1|0|1>
set -u

if [ "$#" -ne 1 ]; then
    echo "usage: wrst <mlan0|mlan1|0|1>"
    exit 2
fi
case "$1" in
    mlan0|mlan1|0|1) ;;
    *) echo "invalid interface: $1"; exit 2 ;;
esac

exec "$(dirname "$0")/rst"
