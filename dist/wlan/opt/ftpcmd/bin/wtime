#!/usr/bin/python3
"""Read local time or use the existing persistent manual clock-setting path."""

import datetime
import re
import subprocess
import sys
import syslog


FAKE_HWCLOCK = "/usr/local/scripts/fake-hwclock.sh"


def fail(code, detail):
    try:
        syslog.syslog(syslog.LOG_ERR, f"ftpcmd_result command=wtime status=fail code={code} detail={detail}")
    except OSError:
        pass
    print(f"wtime: {detail}", file=sys.stderr)
    return code


def current_time():
    now = datetime.datetime.now().astimezone()
    return "TIME=" + now.strftime("%Y-%m-%d %H:%M:%S.%f")[:-3] + " OFFSET=" + now.strftime("%z")


def main(args=None):
    args = sys.argv[1:] if args is None else args
    if not args:
        print(current_time())
        return 0
    if len(args) != 3 or args[0] != "sync":
        return fail(2, "Usage: quote wtime [sync YYYY-MM-DD HH:MM:SS[.mmm]]")
    timestamp = " ".join(args[1:])
    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{1,3})?", timestamp):
        return fail(2, "expected YYYY-MM-DD HH:MM:SS with optional 1-3 fractional digits")
    try:
        date_format = "%Y-%m-%d %H:%M:%S.%f" if "." in timestamp else "%Y-%m-%d %H:%M:%S"
        datetime.datetime.strptime(timestamp, date_format)
    except ValueError:
        return fail(2, "invalid calendar date or time")
    try:
        result = subprocess.run(
            [FAKE_HWCLOCK, "set", timestamp],
            capture_output=True, text=True, timeout=20,
        )
    except subprocess.TimeoutExpired:
        return fail(124, "clock update timed out; the clock may already have changed")
    except OSError as error:
        return fail(1, f"clock helper unavailable: {error}")
    if result.returncode != 0:
        return fail(1, f"clock update/persistence failed rc={result.returncode}; the clock may already have changed")
    print("SUCCESS " + current_time() + "; NTP unchanged")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
