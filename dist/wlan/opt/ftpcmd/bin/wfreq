#!/bin/sh
# Read or store the frequency policy in wpa_supplicant's config file.
#   quote wfreq [mlan0|mlan1] [freq_or_channel...]
set -u

WIFI=/usr/local/bin/wifi
IFACE=mlan0

wfreq_fail() {
    _code=$1
    shift
    logger -p local0.err \
        "ftpcmd_result command=wfreq status=fail code=$_code iface=$IFACE detail=$*" \
        >/dev/null 2>&1 || true
    exit "$_code"
}

case "${1:-}" in
    mlan0|mlan1)
        IFACE=$1
        shift
        ;;
esac

if [ "$#" -gt 0 ]; then
    [ -x "$WIFI" ] || wfreq_fail 1 "wifi executable unavailable"
    DETAIL=$("$WIFI" "$IFACE" freq "$@" 2>&1)
    RC=$?
    if [ "$RC" -ne 0 ]; then
        wfreq_fail "$RC" "$DETAIL"
    fi
    printf 'SUCCESS\n'
    exit 0
fi

CONF="/etc/wpa_supplicant/wpa_supplicant-$IFACE.conf"
[ -r "$CONF" ] || wfreq_fail 1 "profile unavailable"
FREQ_RAW=$(/bin/bash -c '. /usr/local/scripts/wifi_init_config_lib.sh; wifi_wpa_conf_common_freqs "$1"' \
    _ "$CONF" 2>/dev/null) || wfreq_fail 1 "profile frequency lookup failed"

if [ -z "$FREQ_RAW" ]; then
    printf 'ANY\n'
    exit 0
fi
FREQ_LIST=$(printf '%s\n' "$FREQ_RAW" | awk '
    { for (i = 1; i <= NF; i++) {
        if ($i !~ /^[0-9]+$/) bad = 1
        else { if (count++) out = out ","; out = out $i }
    } }
    END { if (bad || !count) exit 1; print out }
') || wfreq_fail 1 "invalid profile frequency list"
printf '%s\n' "$FREQ_LIST"
