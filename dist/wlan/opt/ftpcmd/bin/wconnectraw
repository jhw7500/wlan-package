#!/bin/sh
# Keep FTP output/exit status identical to the local fast-switch command.
if IFS=' .' read -r _raw_sec _raw_centi _raw_rest < /proc/uptime; then
    case "$_raw_sec:$_raw_centi" in
        *[!0-9:]*|:*) ;;
        *)
            _raw_centi=${_raw_centi#0}
            WIFI_RAW_TRACE_START_MS=$((_raw_sec * 1000 + ${_raw_centi:-0} * 10))
            WIFI_RAW_TRACE_ID="$WIFI_RAW_TRACE_START_MS-$$"
            export WIFI_RAW_TRACE_START_MS WIFI_RAW_TRACE_ID
            ;;
    esac
fi
/usr/bin/python3 "$(dirname "$0")/../lib/ftpcmd_log.py" wconnectraw >/dev/null 2>&1 || true

WIFI=/usr/local/bin/wifi
IFACE=${1:-}
[ "$#" -eq 0 ] || shift
WIFI_CONNECT_RAW_ORIGIN=ftp
export WIFI_CONNECT_RAW_ORIGIN
exec "$WIFI" "$IFACE" connectraw "$@"
