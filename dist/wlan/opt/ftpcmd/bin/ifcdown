#!/bin/sh
# Take a network interface down.  Reached over FTP as: quote ifcdown [interface]
#
# With no argument it acts on mlan0.
#
# Run by vsftpd's privileged parent, as root, with cwd / and a fixed PATH.
# vsftpd already restricts arguments to a narrow character set, but the check
# below is what actually decides which interfaces may be touched, so keep it.
#
# Contract: the dispatch rules this relies on -- argv, the environment
# vsftpd exports, the private PID namespace, and the exit-status-to-reply-
# code mapping -- are defined by 0001-vsftpd-external-command-dispatch.patch
# in the meta-cts-wlan layer (recipes-daemons/vsftpd/vsftpd/).  Read that
# patch header before changing anything here.
#
# Reply shape: the dispatch takes the **first stdout line** as the 200 reply
# text when the handler prints one, so that line is the compatibility
# contract -- the FXE3000 card answers "200 IFCDOWN command successful." and the upper tool
# reads it.  Diagnostics go on the lines after it; they stay visible when
# the handler is run from a shell and are ignored by the dispatch.
# (Until the dispatch patch lands the reply is still a canned "200 OK: ifcdown",
# so this ordering is safe either way.)
set -u

IFACE="${1:-mlan0}"

case "$IFACE" in
    *[!A-Za-z0-9._-]*)  echo "invalid interface name: $IFACE"; exit 2 ;;
esac

if [ ! -e "/sys/class/net/$IFACE" ]; then
    echo "no such interface: $IFACE"
    exit 2
fi

# Refuse to cut the interface this very session is riding on.  The reply is
# written after the handler exits, so taking that interface down loses the
# reply and, on a single-homed board, locks the operator out entirely.
# FTPCMD_LOCAL_ADDR is the address the control connection arrived on; vsftpd
# sets it, and it is absent only if vsftpd could not determine the address.
if [ -n "${FTPCMD_LOCAL_ADDR:-}" ]; then
    CTRL_IFACE=$(ip -o addr show 2>/dev/null \
        | awk -v a="$FTPCMD_LOCAL_ADDR" '$4 ~ "^"a"(/|$)" {print $2; exit}')
    if [ "$CTRL_IFACE" = "$IFACE" ]; then
        echo "refusing: $IFACE carries this FTP control connection ($FTPCMD_LOCAL_ADDR)"
        echo "connect over another interface, or run ip link set $IFACE down locally"
        exit 3
    fi
fi

if ! ip link set "$IFACE" down; then
    echo "failed to take down $IFACE"
    exit 1
fi

echo "IFCDOWN command successful."
ip -o link show "$IFACE"
exit 0
