#!/bin/sh
# Bring up a required station interface using the legacy response contract.
#   quote wifcup <mlan0|mlan1|0|1>
set -u

/usr/bin/python3 "$(dirname "$0")/../lib/ftpcmd_log.py" wifcup >/dev/null 2>&1 || true

if [ "$#" -ne 1 ]; then
    echo "usage: wifcup <mlan0|mlan1|0|1>"
    exit 2
fi
case "$1" in
    mlan0|0) IFACE=mlan0 ;;
    mlan1|1) IFACE=mlan1 ;;
    *) echo "invalid interface: $1"; exit 2 ;;
esac

export FTPCMD_START_LOGGED_FOR=ifcup
exec "$(dirname "$0")/ifcup" "$IFACE"
