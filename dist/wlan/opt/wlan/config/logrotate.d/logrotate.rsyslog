# /etc/logrotate.d/rsyslog - Ported from Debian
/var/log/cantops/kern.log
/var/log/cantops/sys.log
/var/log/cantops/logger.log
/var/log/cantops/ui.log
/var/log/cantops/summary/summary.log
/var/log/cantops/cpu/cpu.log
/var/log/cantops/mgmt/mlan0/mgmt.log
/var/log/cantops/mgmt/mlan1/mgmt.log
/var/log/cantops/mgmt/mlan0/gmgmt.log
/var/log/cantops/mgmt/mlan1/gmgmt.log
/var/log/cantops/scan/mlan0/ap.log
/var/log/cantops/scan/mlan0/freq.log
/var/log/cantops/scan/mlan1/ap.log
/var/log/cantops/scan/mlan1/freq.log
/var/log/cantops/wpa/mlan0/wpa.log
/var/log/cantops/wpa/mlan1/wpa.log
/var/log/cantops/ping/mlan0/ping.log
/var/log/cantops/ping/mlan1/ping.log
{
        rotate 14
        daily
        maxsize 50M
        missingok
        notifempty
        delaycompress
        compress
        dateext
        postrotate
                /usr/bin/pkill -HUP rsyslogd 2> /dev/null || true
        endscript
}

/var/log/mail.info
/var/log/mail.warn
/var/log/mail.err
/var/log/mail.log
/var/log/daemon.log
/var/log/kern.log
/var/log/auth.log
/var/log/user.log
/var/log/lpr.log
/var/log/cron.log
/var/log/debug
/var/log/messages
{
        rotate 14
        daily
        missingok
        notifempty
        compress
        delaycompress
        sharedscripts
        postrotate
		/usr/bin/pkill -HUP rsyslogd 2> /dev/null || true
        endscript
}

# stat 로그 — rotate 주기를 변경하려면 daily → weekly 등으로 수정
/var/log/cantops/stat/mlan0/*.log
/var/log/cantops/stat/mlan1/*.log
{
        rotate 14
        daily
        maxsize 50M
        missingok
        notifempty
        delaycompress
        compress
        dateext
        postrotate
                touch /tmp/wifi_stat_init_f
        endscript
}
