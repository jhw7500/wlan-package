[Unit]
Description=WPA supplicant daemon (interface-specific version)
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device
Before=network.target
Wants=network.target

# NetworkManager users will probably want the dbus version instead.

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/log/cantops/wpa/%I
ExecStartPre=/bin/sh -c 'echo "$(date "+%%Y-%%m-%%d %%H:%%M:%%S.%%3N") wpa_supplicant[info] mlan0: START" >> /var/log/cantops/wpa/%I/wpa.log'
ExecStart=/usr/sbin/wpa_supplicant -c/etc/wpa_supplicant/wpa_supplicant-%I.conf -i%I -d
ExecStopPost=/bin/sh -c 'echo "$(date "+%%Y-%%m-%%d %%H:%%M:%%S.%%3N") wpa_supplicant[info] mlan0: STOP" >> /var/log/cantops/wpa/%I/wpa.log'
#ExecStopPost=/bin/sleep 1

[Install]
WantedBy=multi-user.target
