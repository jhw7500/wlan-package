[Unit]
Description=WPA supplicant daemon (interface-specific version)
Requires=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device wifi_init.service
PartOf=wifi_init.service
# netdev 재생성(드라이버 리셋/재로드)으로 supplicant 가 죽는 라운드를 자동 복구한다.
# 좀비로 살아남는 라운드는 프로세스가 죽지 않아 여기서 안 잡히며 99-wlan-wpa-reattach.rules
# 가 덮는다. 영구 오류의 무한 재시작은 StartLimit 으로 막는다 — 값은 이 리포의 감독 계약
# (wifi_link_snapshot@ 등, tests/test_logger_supervision_units.py 가 고정)과 동일하게 맞춘다.
StartLimitIntervalSec=300
StartLimitBurst=10

# NetworkManager users will probably want the dbus version instead.

[Service]
Type=simple
Restart=always
RestartSec=3
# 모듈 재로드 경로(wifi_init.sh)가 rmmod 전에 systemctl stop 으로 동기 대기하므로 상한을
# 둔다. 기본값(DefaultTimeoutStopSec, 통상 90s)이면 SIGTERM 에 반응하지 않는 supplicant
# 하나가 재로드 전체를 90초 지연시킨다. 10초 뒤 systemd 가 SIGKILL 한다.
# (systemctl 에는 --timeout 옵션이 없으므로 상한은 유닛에 둘 수밖에 없다.)
TimeoutStopSec=10
# After=의 순서만으로 parent 성공은 보장되지 않는다. udev reattach/별도 start도
# MAC 초기화 실패(status 78)에서는 차단하고, 설정 수정 뒤 parent restart로 복구한다.
ExecCondition=/usr/local/scripts/wlan_mac_ready.sh %i
ExecStartPre=/bin/mkdir -p /var/log/cantops/wpa/%I
ExecStartPre=/bin/sh -c 'echo "$(date "+%%Y-%%m-%%d %%H:%%M:%%S.%%3N") wpa_supplicant[info] %I: START" >> /var/log/cantops/wpa/%I/wpa.log'
ExecStart=/usr/sbin/wpa_supplicant -c/etc/wpa_supplicant/wpa_supplicant-%I.conf -i%I -d
ExecStopPost=/bin/sh -c 'echo "$(date "+%%Y-%%m-%%d %%H:%%M:%%S.%%3N") wpa_supplicant[info] %I: STOP" >> /var/log/cantops/wpa/%I/wpa.log'
#ExecStopPost=/bin/sleep 1

[Install]
# enable은 wifi_services.sh의 시작 정책 표시로만 사용한다. wifi_init.sh도
# JSON이 허용하고 매니저가 없으면 bridge iface를 직접 start한다. 부팅 target이 직접
# 이 유닛을 pull하면 wifi_init ExecStartPre의 disable로도 예약된 start가 취소되지 않는다.
WantedBy=wifi-supplicant-manual.target
