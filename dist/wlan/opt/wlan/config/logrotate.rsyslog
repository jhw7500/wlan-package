# /etc/logrotate.d/rsyslog - Ported from Debian
/var/log/cantops/kern.log
/var/log/cantops/syslog
/var/log/cantops/sys.log
/var/log/cantops/capture/mlan0/cap.log
/var/log/cantops/capture/mlan1/cap.log
/var/log/cantops/scan/mlan0/*.log
/var/log/cantops/scan/mlan1/*.log
/var/log/cantops/stat/mlan0/*.log
/var/log/cantops/stat/mlan1/*.log
{
        rotate 7
        daily
        missingok
        notifempty
        delaycompress
        compress
    	dateext
        postrotate
                /usr/bin/pkill -HUP rsyslogd 2> /dev/null || true
        endscript
}

/var/log/cantops/capture/mlan0/tmp/*.pcap
{
        rotate 10
        daily
        missingok
        notifempty
        delaycompress
        compress
        dateext
        postrotate
                /usr/bin/pkill -HUP rsyslogd 2> /dev/null || true
        endscript
}

/var/log/mail.info
/var/log/mail.warn
/var/log/mail.err
/var/log/mail.log
/var/log/daemon.log
/var/log/kern.log
/var/log/auth.log
/var/log/user.log
/var/log/lpr.log
/var/log/cron.log
/var/log/debug
/var/log/messages
{
        rotate 4
        weekly
        missingok
        notifempty
        compress
        delaycompress
        sharedscripts
        postrotate
		/usr/bin/pkill -HUP rsyslogd 2> /dev/null || true
        endscript
}
