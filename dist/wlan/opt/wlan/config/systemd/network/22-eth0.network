[Match]
Name=eth0

[Network]
DHCP=no
# BD default management IP (최초 설치 시 SSH 접속용, 사이트별 변경 가능).
# Factory Reset 후의 복구 경로이기도 하다. Factory Reset 은 wpa_supplicant 설정도
# 공장 기본값으로 되돌리므로 기본 SSID 가 현장에 없으면 무선이 안 붙는 것이 정상이고,
# 그때 192.168.1.0/24 호스트를 eth0 에 연결해 이 주소로 접속해 재설정한다.
# 따라서 이 값을 사이트 시험 주소로 바꿔 패키징하면 안 된다 (release gate 가 막는다).
# peer_route 관련 동적 설정(eth0 host scope IP, table 100 link route, main fallback route,
# policy rule iif=eth0→table 100)은 모두 wifi_init.sh가 wbridge.peer_route.enabled 토글에 따라
# 부여/회수한다. systemd-networkd 단계에서 static 부여하면 enabled=false 시 부여 후 제거
# 패턴이 발생하므로 의도적으로 분리.
Address=192.168.1.1/24
# 캐리어 flap/케이블 재연결 시 주소 회수→재부여로 eth0 주소 순서가 뒤집혀
# (wifi_init.sh eth_fallback의 /32 미러가 첫 주소가 됨) ifconfig류 표시가
# 장치마다 달라지는 문제 방지 — 주소를 캐리어와 무관하게 부여·유지해
# 192.168.1.1/24가 항상 첫 주소로 고정된다 (기능 영향 없음, 표시 결정성).
# 아래 두 줄은 의도적으로 비활성이다. 표시 결정성만을 위한 것이고, peer 채널 동작은
# 이 순서에 기대지 않는다 — wired_mac_ip_get.py 가 host route 에 src 를 명시적으로
# 고정한다. 켜면 캐리어 없는 상태에서도 주소를 부여·유지하게 되므로 enabled=false
# 경로의 주소 회수 동작과의 상호작용을 다시 검토한 뒤에 활성화할 것.
#ConfigureWithoutCarrier=yes
#KeepConfiguration=static
# IPv6 비활성 (#255, 근거는 20-mlan0.network 주석): eth0도 함께 꺼서
# 유선 폐쇄망에 불필요한 ND/RA·link-local을 남기지 않는다.
LinkLocalAddressing=no
IPv6AcceptRA=no
